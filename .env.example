# Grupo Fénix - Variables de Entorno

# ===================================
# SUPABASE
# ===================================
PUBLIC_SUPABASE_URL="https://[TU-PROYECTO].supabase.co"
PUBLIC_SUPABASE_ANON_KEY="[TU-SUPABASE-ANON-KEY]"

# SERVICIO DE SUPABASE (SOLO servidor, para /api/admin)
# NUNCA usar PUBLIC_ en esta variable: da acceso total a la base.
SUPABASE_SERVICE_ROLE_KEY="[TU-SUPABASE-SERVICE-ROLE-KEY]"

# ===================================
# STRIPE (Pagos)
# ===================================
# Clave secreta (SOLO servidor - NUNCA exponer al cliente)
STRIPE_SECRET_KEY="sk_test_[TU-CLAVE-SECRETA-STRIPE]"

# Secreto del Webhook (se genera al crear el webhook en Stripe)
STRIPE_WEBHOOK_SECRET="whsec_[TU-WEBHOOK-SECRET]"

# ===================================
# OWNCAST (Video en Vivo - 100% Gratis)
# ===================================
# URL base de tu instancia Owncast (HLS)
# Ejemplo: https://tu-owncast.tudominio.com o http://IP:8080
PUBLIC_OWNCAST_BASE_URL="https://[TU-OWNCAST-URL]"

# ===================================
# NOTAS
# ===================================
# - Las variables con "PUBLIC_" son accesibles desde el cliente (Astro + React)
# - Las variables SIN "PUBLIC_" SOLO deben usarse en src/pages/api/ (lado servidor)
# - Para desarrollo local copia este archivo a .env y rellena con tus datos
# - NUNCA subas el archivo .env al repositorio
