---
import BaseLayout from './BaseLayout.astro'
import TopBar from '../components/navigation/TopBar.astro'
import BottomNav from '../components/navigation/BottomNav.astro'

interface Props {
  title: string
  section?: string
  showBack?: boolean
  showSettings?: boolean
  active?: string
}

const { title, section, showBack = false, showSettings = false, active } = Astro.props
const currentPath = Astro.url.pathname
---
<BaseLayout title={title}>
  <div class="min-h-screen bg-surface pb-28">
    <TopBar title={section} showBack={showBack} showSettings={showSettings} />
    <main class="px-5 max-w-2xl mx-auto">
      <slot />
    </main>
    <BottomNav currentPath={active ?? currentPath} />
  </div>
</BaseLayout>
