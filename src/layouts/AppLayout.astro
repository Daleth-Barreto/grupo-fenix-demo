---
import BaseLayout from './BaseLayout.astro'
import TopBar from '../components/navigation/TopBar.astro'
import BottomNav from '../components/navigation/BottomNav.astro'
import AuthGuard from '../components/auth/AuthGuard'

interface Props {
  title: string
  section?: string
  showBack?: boolean
  showSettings?: boolean
  showLogout?: boolean
  active?: string
  requireAuth?: boolean
}

const { title, section, showBack = false, showSettings = false, showLogout = false, active, requireAuth = true } = Astro.props
const currentPath = Astro.url.pathname
---
<BaseLayout title={title}>
  {requireAuth ? (
    <AuthGuard client:load>
      <div class="min-h-screen bg-surface" style="padding-bottom: calc(5.5rem + env(safe-area-inset-bottom, 0px));">
        <TopBar title={section} showBack={showBack} showSettings={showSettings} showLogout={showLogout} />
        <main class="px-4 sm:px-5 max-w-2xl mx-auto">
          <slot />
        </main>
        <BottomNav currentPath={active ?? currentPath} />
      </div>
    </AuthGuard>
  ) : (
    <div class="min-h-screen bg-surface" style="padding-bottom: calc(5.5rem + env(safe-area-inset-bottom, 0px));">
      <TopBar title={section} showBack={showBack} showSettings={showSettings} showLogout={showLogout} />
      <main class="px-4 sm:px-5 max-w-2xl mx-auto">
        <slot />
      </main>
      <BottomNav currentPath={active ?? currentPath} />
      <script is:inline>document.documentElement.dataset.appReady = 'true'</script>
    </div>
  )}
</BaseLayout>
