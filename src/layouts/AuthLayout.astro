---
import BaseLayout from './BaseLayout.astro'

interface Props {
  title: string
  heading: string
  subtitle?: string
}

const { title, heading, subtitle } = Astro.props
---
<BaseLayout title={title}>
  <div class="min-h-screen bg-background flex flex-col">
    <!-- Hero superior Deep Navy -->
    <div class="bg-navy-gradient pt-14 pb-10 px-6 rounded-b-[2.5rem] shadow-hero relative overflow-hidden">
      <div class="absolute top-0 left-0 right-0 h-1 accent-line"></div>
      <img
        src="/brand/phoenix/phoenix_5_white.png"
        alt=""
        aria-hidden="true"
        class="absolute -right-10 -top-6 w-52 opacity-[0.06] pointer-events-none select-none"
      />
      <div class="relative z-10 flex flex-col items-center text-center animate-fade-in-up">
        <div class="w-20 h-20 rounded-2xl bg-white flex items-center justify-center mb-4 shadow-card p-2.5">
          <img src="/brand/logo-fenix-navy.png" alt="Grupo Fénix" class="w-full h-full object-contain" />
        </div>
        <h1 class="text-2xl font-bold text-white tracking-tight">{heading}</h1>
        {subtitle && <p class="text-sm text-primary-fixed-dim mt-1">{subtitle}</p>}
      </div>
    </div>

    <main class="flex-1 px-6 py-8 max-w-md w-full mx-auto">
      <slot />
    </main>
  </div>
</BaseLayout>
