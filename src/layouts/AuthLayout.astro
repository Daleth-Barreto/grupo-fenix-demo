---
import BaseLayout from './BaseLayout.astro'

interface Props {
  title: string
  heading?: string
  subtitle?: string
}

const { title, heading, subtitle } = Astro.props
---
<BaseLayout title={title}>
  <div class="min-h-screen bg-background flex flex-col">
    <!-- Hero superior Deep Navy con el logo como protagonista -->
    <div class="bg-navy-gradient pt-16 pb-20 px-6 rounded-b-[2.75rem] shadow-hero relative overflow-hidden">
      <div class="absolute top-0 left-0 right-0 h-1 accent-line"></div>
      <img
        src="/brand/phoenix/phoenix_5_white.png"
        alt=""
        aria-hidden="true"
        class="absolute left-1/2 -translate-x-1/2 -top-4 w-[26rem] max-w-none opacity-[0.10] pointer-events-none select-none"
      />
      <div class="relative z-10 flex flex-col items-center text-center animate-fade-in-up">
        <img src="/brand/logo-fenix.png" alt="Grupo Fénix" class="w-44 max-w-[62%] object-contain drop-shadow-lg" />
        {heading && <h1 class="text-2xl font-bold text-white tracking-tight mt-3">{heading}</h1>}
        {subtitle && <p class="text-sm text-primary-fixed-dim mt-2">{subtitle}</p>}
      </div>
    </div>

    <!-- Formulario en tarjeta superpuesta -->
    <main class="flex-1 px-5 -mt-10 pb-8 max-w-md w-full mx-auto relative z-10">
      <div class="bg-surface rounded-3xl shadow-elevated border border-surface-variant/60 p-6 animate-fade-in-up">
        <slot />
      </div>
    </main>
  </div>
</BaseLayout>
