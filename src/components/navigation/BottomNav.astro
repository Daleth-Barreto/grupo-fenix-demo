---
interface Tab {
  path: string
  icon: string
  label: string
  match?: string[]
}

interface Props {
  currentPath: string
}

const { currentPath } = Astro.props

const TABS: Tab[] = [
  { path: '/app/inicio', icon: 'home', label: 'Inicio' },
  { path: '/app/congresos', icon: 'local_activity', label: 'Congresos', match: ['/app/congresos', '/app/checkout', '/app/galeria', '/app/reservaciones'] },
  { path: '/app/cursos', icon: 'play_circle', label: 'Mis Cursos' },
  { path: '/app/perfil', icon: 'person', label: 'Perfil', match: ['/app/perfil', '/app/configuracion', '/app/constancias'] },
]

function isActive(tab: Tab, path: string): boolean {
  const targets = tab.match ?? [tab.path]
  return targets.some((t) => path === t || path.startsWith(`${t}/`))
}
---
<nav
  class="fixed bottom-0 left-0 right-0 z-50 flex justify-around items-center bg-surface/98 backdrop-blur-lg border-t border-surface-variant shadow-[0_-4px_24px_rgba(10,25,47,0.08)]"
  style="padding-top: 6px; padding-bottom: calc(6px + env(safe-area-inset-bottom, 0px));"
>
  {TABS.map((tab) => {
    const active = isActive(tab, currentPath)
    return (
      <a
        href={tab.path}
        class:list={[
          'relative flex flex-col items-center justify-center flex-1 min-h-[56px] gap-0.5 transition-all duration-200 active:scale-95',
          active ? 'text-secondary' : 'text-outline hover:text-secondary',
        ]}
      >
        <span
          class:list={[
            'absolute top-0 h-0.5 rounded-full transition-all duration-300 accent-line',
            active ? 'w-8 opacity-100' : 'w-0 opacity-0',
          ]}
        />
        <span
          class="material-symbols-outlined text-[26px]"
          style={active ? "font-variation-settings: 'FILL' 1" : undefined}
        >
          {tab.icon}
        </span>
        <span class:list={['text-[10px] leading-tight', active ? 'font-semibold' : 'font-medium']}>
          {tab.label}
        </span>
      </a>
    )
  })}
</nav>
