---
import LogoutButton from './LogoutButton'

interface Props {
  title?: string
  showBack?: boolean
  showSettings?: boolean
  showLogout?: boolean
}
const { title, showBack = false, showSettings = false, showLogout = false } = Astro.props
const section = title && title !== 'Grupo FÉNIX' ? title : null
---
<header class="sticky top-0 z-40 bg-surface/98 backdrop-blur-lg border-b border-surface-variant flex items-center justify-between px-4 sm:px-5 h-16 shadow-sm" style="padding-top: env(safe-area-inset-top, 0px); height: calc(4rem + env(safe-area-inset-top, 0px));">
  <div class="w-11 flex items-center">
    {showBack && (
      <button type="button" onclick="history.back()" class="text-primary hover:opacity-70 p-2.5 -ml-2 rounded-full transition-opacity active:scale-95 duration-150 min-w-[44px] min-h-[44px] flex items-center justify-center">
        <span class="material-symbols-outlined">arrow_back</span>
      </button>
    )}
  </div>

  <div class="flex flex-col items-center leading-tight flex-1">
    <span class="font-bold text-primary text-[16px] tracking-tight">
      Grupo <span class="text-secondary">FÉNIX</span>
    </span>
    {section && (
      <span class="text-[11px] font-medium text-outline -mt-0.5 max-w-[50vw] truncate">
        {section}
      </span>
    )}
  </div>

  <div class="w-11 flex justify-end">
    {showSettings && !showLogout && (
      <a href="/app/configuracion" class="text-primary hover:opacity-70 p-2.5 -mr-2 rounded-full transition-opacity active:scale-95 duration-150 min-w-[44px] min-h-[44px] flex items-center justify-center">
        <span class="material-symbols-outlined">settings</span>
      </a>
    )}
    {showLogout && (
      <LogoutButton client:load />
    )}
  </div>
</header>
