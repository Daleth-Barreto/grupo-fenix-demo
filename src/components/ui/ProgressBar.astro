---
interface Props { value: number; showLabel?: boolean; class?: string }
const { value, showLabel = false, class: cls = '' } = Astro.props
const clamped = Math.min(100, Math.max(0, value))
---
<div class:list={['flex items-center gap-3', cls]}>
  <div class="flex-1 h-1.5 bg-[#dce2f3] rounded-full overflow-hidden">
    <div class="h-full bg-[#fe9511] rounded-full transition-all duration-700" style={`width:${clamped}%`}></div>
  </div>
  {showLabel && <span class="text-xs text-[#44474d] w-8 text-right font-medium">{value}%</span>}
</div>
