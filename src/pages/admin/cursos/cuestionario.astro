---
import AdminLayout from '../../../layouts/AdminLayout.astro'
import CrudManager from '../../../components/admin/CrudManager'
---
<AdminLayout title="Cuestionario" section="Cursos / Cuestionario">
  <div class="flex flex-col gap-4">
    <a href="/admin/cursos" class="text-sm font-semibold text-primary underline self-start">Volver a cursos</a>
    <h1 class="text-[28px] font-bold text-primary">Preguntas del cuestionario</h1>
    <CrudManager client:only="react" section="quiz" scope={{ column: 'lesson_id', param: 'id' }} />
  </div>
</AdminLayout>
