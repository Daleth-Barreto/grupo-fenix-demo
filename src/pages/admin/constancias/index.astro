---
import AdminLayout from '../../../layouts/AdminLayout.astro'
---
<AdminLayout title="Constancias" section="Constancias">
  <div class="flex flex-col gap-6">
    <div class="flex items-center justify-between">
      <div>
        <h1 class="text-[28px] font-bold text-primary">Emisión de Constancias</h1>
        <p class="text-sm text-on-surface-variant mt-1">Genera y envía constancias a participantes</p>
      </div>
      <button class="inline-flex items-center gap-2 bg-secondary text-on-secondary px-5 py-2.5 rounded-xl font-semibold text-sm hover:bg-secondary-deep transition-colors min-h-[44px]">
        <span class="material-symbols-outlined text-[20px]">workspace_premium</span>
        Generar constancias
      </button>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
      {[
        { label: 'Pendientes', value: '0', icon: 'pending_actions', color: 'bg-amber-100 text-amber-700' },
        { label: 'Emitidas', value: '0', icon: 'verified', color: 'bg-green-100 text-green-700' },
        { label: 'Enviadas', value: '0', icon: 'send', color: 'bg-blue-100 text-blue-700' },
      ].map((stat) => (
        <div class="bg-white rounded-2xl p-5 border border-[#dce2f3] shadow-sm">
          <div class="flex items-center justify-between">
            <div>
              <p class="text-sm text-on-surface-variant">{stat.label}</p>
              <p class="text-2xl font-bold text-primary mt-1">{stat.value}</p>
            </div>
            <div class={`w-12 h-12 rounded-xl flex items-center justify-center ${stat.color}`}>
              <span class="material-symbols-outlined text-[26px]">{stat.icon}</span>
            </div>
          </div>
        </div>
      ))}
    </div>

    <div class="bg-white rounded-2xl border border-[#dce2f3] shadow-sm overflow-hidden">
      <div class="px-6 py-4 border-b border-[#dce2f3]">
        <p class="text-sm text-on-surface-variant">Historial de constancias</p>
      </div>
      <div class="p-8 text-center text-on-surface-variant">
        <span class="material-symbols-outlined text-[48px] block mb-3 text-outline">workspace_premium</span>
        <p class="font-medium">Sin constancias generadas</p>
        <p class="text-sm mt-1">Selecciona participantes con asistencia/progreso completo para emitirlas</p>
      </div>
    </div>
  </div>
</AdminLayout>
