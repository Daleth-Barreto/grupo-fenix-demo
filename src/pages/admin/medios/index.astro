---
import AdminLayout from '../../../layouts/AdminLayout.astro'
import MediaLibrary from '../../../components/admin/MediaLibrary'
---
<AdminLayout title="Biblioteca de Medios" section="Biblioteca de Medios">
  <div class="flex flex-col gap-6">
    <div>
      <h1 class="text-[28px] font-bold text-primary">Biblioteca de Medios</h1>
      <p class="text-sm text-on-surface-variant mt-1">Sube imágenes y documentos, y copia su dirección para usarla en eventos y cursos.</p>
    </div>
    <MediaLibrary client:only="react" />
  </div>
</AdminLayout>
