---
import AdminLayout from '../../../layouts/AdminLayout.astro'
---
<AdminLayout title="Configuración" section="Configuración">
  <div class="flex flex-col gap-6 max-w-4xl">
    <div>
      <h1 class="text-[28px] font-bold text-primary">Configuración</h1>
      <p class="text-sm text-on-surface-variant mt-1">Ajustes generales de la plataforma</p>
    </div>

    <div class="bg-white rounded-2xl border border-[#dce2f3] shadow-sm overflow-hidden">
      <div class="px-6 py-4 border-b border-[#dce2f3]">
        <h2 class="font-semibold text-primary">Información de la plataforma</h2>
      </div>
      <div class="p-6 flex flex-col gap-4">
        <div class="flex flex-col gap-2">
          <label class="text-sm font-semibold text-primary">Nombre de la plataforma</label>
          <input type="text" value="Grupo Fénix" class="w-full px-4 py-3 rounded-xl border border-[#dce2f3] focus:border-secondary focus:ring-4 focus:ring-secondary/10 outline-none transition-all text-base" />
        </div>
        <div class="flex flex-col gap-2">
          <label class="text-sm font-semibold text-primary">Correo de contacto</label>
          <input type="email" placeholder="contacto@grupofenix.com" class="w-full px-4 py-3 rounded-xl border border-[#dce2f3] focus:border-secondary focus:ring-4 focus:ring-secondary/10 outline-none transition-all text-base" />
        </div>
        <div class="flex flex-col gap-2">
          <label class="text-sm font-semibold text-primary">Teléfono</label>
          <input type="tel" placeholder="+52 ..." class="w-full px-4 py-3 rounded-xl border border-[#dce2f3] focus:border-secondary focus:ring-4 focus:ring-secondary/10 outline-none transition-all text-base" />
        </div>
      </div>
    </div>

    <div class="bg-white rounded-2xl border border-[#dce2f3] shadow-sm overflow-hidden">
      <div class="px-6 py-4 border-b border-[#dce2f3]">
        <h2 class="font-semibold text-primary">Integraciones</h2>
      </div>
      <div class="p-6 flex flex-col gap-4">
        <div class="flex items-center justify-between p-4 rounded-xl bg-surface-container-low">
          <div class="flex items-center gap-3">
            <span class="material-symbols-outlined text-primary">payments</span>
            <div>
              <p class="text-sm font-semibold text-primary">Stripe</p>
              <p class="text-xs text-on-surface-variant">Pagos con tarjeta</p>
            </div>
          </div>
          <span class="text-xs px-2 py-1 bg-green-100 text-green-700 rounded-full font-semibold">Configurado</span>
        </div>
        <div class="flex items-center justify-between p-4 rounded-xl bg-surface-container-low">
          <div class="flex items-center gap-3">
            <span class="material-symbols-outlined text-primary">podcasts</span>
            <div>
              <p class="text-sm font-semibold text-primary">Owncast</p>
              <p class="text-xs text-on-surface-variant">Video en vivo</p>
            </div>
          </div>
          <span class="text-xs px-2 py-1 bg-amber-100 text-amber-700 rounded-full font-semibold">Por configurar</span>
        </div>
        <div class="flex items-center justify-between p-4 rounded-xl bg-surface-container-low">
          <div class="flex items-center gap-3">
            <span class="material-symbols-outlined text-primary">cloud</span>
            <div>
              <p class="text-sm font-semibold text-primary">Supabase</p>
              <p class="text-xs text-on-surface-variant">Base de datos y auth</p>
            </div>
          </div>
          <span class="text-xs px-2 py-1 bg-green-100 text-green-700 rounded-full font-semibold">Conectado</span>
        </div>
      </div>
    </div>

    <div class="flex flex-col sm:flex-row gap-3">
      <button class="flex-1 sm:flex-none inline-flex items-center justify-center gap-2 bg-secondary text-on-secondary px-8 py-3 rounded-xl font-semibold hover:bg-secondary-deep transition-colors min-h-[48px]">
        <span class="material-symbols-outlined text-[20px]">save</span>
        Guardar cambios
      </button>
    </div>
  </div>
</AdminLayout>
