---
import AdminLayout from '../../../layouts/AdminLayout.astro'
---
<AdminLayout title="Configuración" section="Configuración">
  <div class="flex flex-col gap-6 max-w-4xl">
    <div>
      <h1 class="text-[28px] font-bold text-primary">Configuración</h1>
      <p class="text-sm text-on-surface-variant mt-1">Estado de las integraciones. Las claves se configuran como secretos del servidor.</p>
    </div>

    <div class="bg-white rounded-2xl border border-[#dce2f3] shadow-sm overflow-hidden">
      <div class="px-6 py-4 border-b border-[#dce2f3]">
        <h2 class="font-semibold text-primary">Integraciones</h2>
      </div>
      <div class="p-6 flex flex-col gap-4">
        <div class="flex items-center justify-between p-4 rounded-xl bg-surface-container-low">
          <div class="flex items-center gap-3">
            <span class="material-symbols-outlined text-primary">payments</span>
            <div>
              <p class="text-sm font-semibold text-primary">Stripe</p>
              <p class="text-xs text-on-surface-variant">Pagos con tarjeta</p>
            </div>
          </div>
          <span data-integration="stripe" class="text-xs px-2 py-1 bg-surface-container text-on-surface-variant rounded-full font-semibold">Verificando…</span>
        </div>
        <div class="flex items-center justify-between p-4 rounded-xl bg-surface-container-low">
          <div class="flex items-center gap-3">
            <span class="material-symbols-outlined text-primary">podcasts</span>
            <div>
              <p class="text-sm font-semibold text-primary">Owncast</p>
              <p class="text-xs text-on-surface-variant">Video en vivo</p>
            </div>
          </div>
          <span data-integration="owncast" class="text-xs px-2 py-1 bg-surface-container text-on-surface-variant rounded-full font-semibold">Verificando…</span>
        </div>
        <div class="flex items-center justify-between p-4 rounded-xl bg-surface-container-low">
          <div class="flex items-center gap-3">
            <span class="material-symbols-outlined text-primary">cloud</span>
            <div>
              <p class="text-sm font-semibold text-primary">Supabase</p>
              <p class="text-xs text-on-surface-variant">Base de datos y auth</p>
            </div>
          </div>
          <span data-integration="supabase" class="text-xs px-2 py-1 bg-surface-container text-on-surface-variant rounded-full font-semibold">Verificando…</span>
        </div>
      </div>
    </div>
  </div>

  <script>
    import { adminFetch } from '../../../lib/admin-fetch'
    import { onAppReady } from '../../../utils/app-ready'

    onAppReady(async () => {
      const res = await adminFetch('/api/admin/integrations')
      const status = res.ok ? ((await res.json()) as Record<string, boolean>) : null
      document.querySelectorAll<HTMLElement>('[data-integration]').forEach((el) => {
        const on = status?.[el.dataset.integration ?? '']
        el.textContent = status === null ? 'Sin permiso' : on ? 'Configurado' : 'Por configurar'
        el.className = `text-xs px-2 py-1 rounded-full font-semibold ${on ? 'bg-green-100 text-green-700' : 'bg-amber-100 text-amber-700'}`
      })
    })
  </script>
</AdminLayout>
