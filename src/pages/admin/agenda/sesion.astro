---
import AdminLayout from '../../../layouts/AdminLayout.astro'
import CrudManager from '../../../components/admin/CrudManager'
---
<AdminLayout title="Sesión" section="Agenda / Sesión">
  <div class="flex flex-col gap-8">
    <a href="/admin/agenda" class="text-sm font-semibold text-primary underline self-start">Volver a la agenda</a>
    <section class="flex flex-col gap-3">
      <h1 class="text-[24px] font-bold text-primary">Preguntas del público</h1>
      <CrudManager client:only="react" section="questions" scope={{ column: 'session_id', param: 'id' }} />
    </section>
    <section class="flex flex-col gap-3">
      <h2 class="text-[20px] font-bold text-primary">Encuestas</h2>
      <CrudManager client:only="react" section="polls" scope={{ column: 'session_id', param: 'id' }} />
    </section>
    <section class="flex flex-col gap-3">
      <h2 class="text-[20px] font-bold text-primary">Materiales y grabaciones</h2>
      <CrudManager client:only="react" section="materials" scope={{ column: 'session_id', param: 'id' }} />
    </section>
  </div>
</AdminLayout>
