---
import AdminLayout from '../../../layouts/AdminLayout.astro'
---
<AdminLayout title="Nuevo Evento" section="Eventos / Nuevo">
  <div class="flex flex-col gap-6 max-w-4xl">
    <div class="flex items-center gap-4">
      <a href="/admin/eventos" class="p-2 rounded-xl hover:bg-surface-container-low transition-colors min-w-[44px] min-h-[44px] flex items-center justify-center">
        <span class="material-symbols-outlined">arrow_back</span>
      </a>
      <div>
        <h1 class="text-[28px] font-bold text-primary">Crear Nuevo Evento / Congreso</h1>
        <p class="text-sm text-on-surface-variant mt-1">Completa la información del evento</p>
      </div>
    </div>

    <form id="event-form" class="flex flex-col gap-6">
      <div class="bg-white rounded-2xl border border-[#dce2f3] shadow-sm overflow-hidden">
        <div class="px-6 py-4 border-b border-[#dce2f3]">
          <h2 class="font-semibold text-primary">Información General</h2>
        </div>
        <div class="p-6 grid grid-cols-1 md:grid-cols-2 gap-4">
          <div class="md:col-span-2 flex flex-col gap-2">
            <label class="text-sm font-semibold text-primary">Título del evento *</label>
            <input name="title" required type="text" placeholder="Ej. 1er Congreso Internacional..." class="w-full px-4 py-3 rounded-xl border border-[#dce2f3] focus:border-secondary focus:ring-4 focus:ring-secondary/10 outline-none transition-all text-base" />
          </div>
          <div class="md:col-span-2 flex flex-col gap-2">
            <label class="text-sm font-semibold text-primary">Descripción *</label>
            <textarea name="description" required rows="4" placeholder="Describe el evento..." class="w-full px-4 py-3 rounded-xl border border-[#dce2f3] focus:border-secondary focus:ring-4 focus:ring-secondary/10 outline-none transition-all text-base resize-none"></textarea>
          </div>
          <div class="flex flex-col gap-2">
            <label class="text-sm font-semibold text-primary">Categoría *</label>
            <select name="category" required class="w-full px-4 py-3 rounded-xl border border-[#dce2f3] focus:border-secondary focus:ring-4 focus:ring-secondary/10 outline-none transition-all text-base">
              <option value="congreso">Congreso</option>
              <option value="capacitacion">Capacitación</option>
              <option value="curso">Curso</option>
              <option value="taller">Taller</option>
              <option value="diplomado">Diplomado</option>
              <option value="seminario">Seminario</option>
            </select>
          </div>
          <div class="flex flex-col gap-2">
            <label class="text-sm font-semibold text-primary">Modalidad *</label>
            <select name="modality" required class="w-full px-4 py-3 rounded-xl border border-[#dce2f3] focus:border-secondary focus:ring-4 focus:ring-secondary/10 outline-none transition-all text-base">
              <option value="presencial">Presencial</option>
              <option value="en_linea">En línea</option>
              <option value="hibrido">Híbrido</option>
            </select>
          </div>
        </div>
      </div>

      <div class="bg-white rounded-2xl border border-[#dce2f3] shadow-sm overflow-hidden">
        <div class="px-6 py-4 border-b border-[#dce2f3]">
          <h2 class="font-semibold text-primary">Fechas, Lugar y Precio</h2>
        </div>
        <div class="p-6 grid grid-cols-1 md:grid-cols-2 gap-4">
          <div class="flex flex-col gap-2">
            <label class="text-sm font-semibold text-primary">Fecha de inicio *</label>
            <input name="start_date" required type="date" class="w-full px-4 py-3 rounded-xl border border-[#dce2f3] focus:border-secondary focus:ring-4 focus:ring-secondary/10 outline-none transition-all text-base" />
          </div>
          <div class="flex flex-col gap-2">
            <label class="text-sm font-semibold text-primary">Fecha de fin *</label>
            <input name="end_date" required type="date" class="w-full px-4 py-3 rounded-xl border border-[#dce2f3] focus:border-secondary focus:ring-4 focus:ring-secondary/10 outline-none transition-all text-base" />
          </div>
          <div class="md:col-span-2 flex flex-col gap-2">
            <label class="text-sm font-semibold text-primary">Lugar / Plataforma</label>
            <input name="location" type="text" placeholder="Ciudad, Hotel o URL de plataforma" class="w-full px-4 py-3 rounded-xl border border-[#dce2f3] focus:border-secondary focus:ring-4 focus:ring-secondary/10 outline-none transition-all text-base" />
          </div>
          <div class="flex flex-col gap-2">
            <label class="text-sm font-semibold text-primary">Precio (MXN) *</label>
            <input name="price" required type="number" step="0.01" placeholder="2500" class="w-full px-4 py-3 rounded-xl border border-[#dce2f3] focus:border-secondary focus:ring-4 focus:ring-secondary/10 outline-none transition-all text-base" />
          </div>
          <div class="flex flex-col gap-2">
            <label class="text-sm font-semibold text-primary">Horas curriculares</label>
            <input name="hours" type="number" placeholder="32" class="w-full px-4 py-3 rounded-xl border border-[#dce2f3] focus:border-secondary focus:ring-4 focus:ring-secondary/10 outline-none transition-all text-base" />
          </div>
        </div>
      </div>

      <div class="flex flex-col sm:flex-row gap-3">
        <button type="submit" class="flex-1 sm:flex-none inline-flex items-center justify-center gap-2 bg-secondary text-on-secondary px-8 py-3 rounded-xl font-semibold hover:bg-secondary-deep transition-colors min-h-[48px]">
          <span class="material-symbols-outlined text-[20px]">save</span>
          Guardar Evento
        </button>
        <a href="/admin/eventos" class="flex-1 sm:flex-none inline-flex items-center justify-center gap-2 bg-white text-primary px-8 py-3 rounded-xl font-semibold border border-[#dce2f3] hover:bg-surface-container-low transition-colors min-h-[48px]">
          Cancelar
        </a>
      </div>
    </form>
  </div>

  <script>
    const form = document.getElementById('event-form') as HTMLFormElement
    form?.addEventListener('submit', async (e) => {
      e.preventDefault()
      const formData = new FormData(form)
      const body: any = {}
      formData.forEach((v, k) => {
        if (k === 'price' || k === 'hours') body[k] = v === '' ? null : Number(v)
        else body[k] = v
      })
      const res = await fetch('/api/admin/events', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(body)
      })
      const json = await res.json()
      if (res.ok) {
        alert('Evento creado correctamente')
        window.location.href = '/admin/eventos'
      } else {
        alert(json.error || 'Error al crear evento')
      }
    })
  </script>
</AdminLayout>
