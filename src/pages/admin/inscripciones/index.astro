---
import AdminLayout from '../../../layouts/AdminLayout.astro'
---
<AdminLayout title="Inscripciones" section="Inscripciones">
  <div class="flex flex-col gap-6">
    <div>
      <h1 class="text-[28px] font-bold text-primary">Inscripciones / Órdenes</h1>
      <p class="text-sm text-on-surface-variant mt-1">Compras del sitio y solicitudes de cotización</p>
    </div>

    <div class="bg-white rounded-2xl border border-[#dce2f3] shadow-sm overflow-hidden">
      <div class="px-6 py-4 border-b border-[#dce2f3] flex flex-wrap gap-2 items-center justify-between">
        <p class="text-sm text-on-surface-variant">Órdenes</p>
        <div class="flex flex-wrap items-center gap-2">
          <input id="orders-search" type="search" aria-label="Buscar por comprador o evento" placeholder="Buscar por comprador o evento..." class="px-3 py-2 rounded-xl border border-[#dce2f3] text-sm focus:border-secondary focus:ring-4 focus:ring-secondary/10 outline-none transition-all" />
          <select id="orders-status" aria-label="Filtrar por estado" class="px-3 py-2 rounded-xl border border-[#dce2f3] text-sm focus:border-secondary focus:ring-4 focus:ring-secondary/10 outline-none transition-all">
            <option value="">Todos los estados</option>
            <option value="pendiente">Pendiente</option>
            <option value="pagado">Pagado</option>
            <option value="cancelado">Cancelado</option>
            <option value="reembolsado">Reembolsado</option>
          </select>
        </div>
      </div>
      <div id="orders-list" class="divide-y divide-[#dce2f3]"></div>
      <p id="orders-message" role="status" class="p-8 text-center text-sm text-on-surface-variant">Cargando órdenes…</p>
    </div>

    <div class="bg-white rounded-2xl border border-[#dce2f3] shadow-sm overflow-hidden">
      <div class="px-6 py-4 border-b border-[#dce2f3]">
        <p class="text-sm text-on-surface-variant">Solicitudes de cotización</p>
      </div>
      <div id="requests-list" class="divide-y divide-[#dce2f3]"></div>
      <p id="requests-message" role="status" class="p-8 text-center text-sm text-on-surface-variant">Cargando solicitudes…</p>
    </div>
  </div>

  <script>
    import { adminFetch } from '../../../lib/admin-fetch'
    import { onAppReady } from '../../../utils/app-ready'
    import { escapeHtml } from '../../../utils/escape-html'
    import { formatPrice } from '../../../utils/format'

    const date = (value: string) => new Date(value).toLocaleDateString('es-MX', { day: 'numeric', month: 'short', year: 'numeric' })

    onAppReady(async () => {
      const list = document.getElementById('orders-list')!
      const message = document.getElementById('orders-message')!
      const search = document.getElementById('orders-search') as unknown as HTMLInputElement
      const status = document.getElementById('orders-status') as unknown as HTMLSelectElement
      let orders: any[] = []

      const render = () => {
        const term = search.value.trim().toLowerCase()
        const rows = orders.filter((o) =>
          (!status.value || o.status === status.value) &&
          (!term || `${o.buyer ?? ''} ${o.metadata?.event_title ?? ''}`.toLowerCase().includes(term)))
        message.textContent = rows.length ? '' : 'Sin órdenes para mostrar.'
        message.classList.toggle('hidden', rows.length > 0)
        list.innerHTML = rows.map((o) => `
          <div class="p-4 sm:p-6 flex flex-wrap items-center justify-between gap-3">
            <div class="min-w-0">
              <p class="font-semibold text-primary">${escapeHtml(o.metadata?.event_title || 'Compra')}</p>
              <p class="text-sm text-on-surface-variant">${escapeHtml(o.buyer || 'Sin nombre')} · ${escapeHtml(date(o.created_at))}</p>
            </div>
            <div class="text-right">
              <p class="font-bold text-primary">${escapeHtml(formatPrice(Number(o.amount)))}</p>
              <p class="text-xs text-on-surface-variant">${escapeHtml(o.status)}</p>
            </div>
          </div>`).join('')
      }

      const res = await adminFetch('/api/admin/orders')
      const body = (await res.json().catch(() => ({}))) as any
      if (res.ok) {
        orders = body.data ?? []
        render()
        search.addEventListener('input', render)
        status.addEventListener('change', render)
      } else {
        message.textContent = body.error || 'No se pudieron cargar las órdenes.'
      }

      const requests = document.getElementById('requests-list')!
      const requestsMessage = document.getElementById('requests-message')!
      const reqRes = await adminFetch('/api/admin/reservations')
      const reqBody = (await reqRes.json().catch(() => ({}))) as any
      if (!reqRes.ok) {
        requestsMessage.textContent = reqBody.error || 'No se pudieron cargar las solicitudes.'
        return
      }
      const rows: any[] = reqBody.data ?? []
      requestsMessage.textContent = rows.length ? '' : 'Sin solicitudes todavía.'
      requestsMessage.classList.toggle('hidden', rows.length > 0)
      requests.innerHTML = rows.map((r) => `
        <div class="p-4 sm:p-6 flex flex-col gap-1">
          <p class="font-semibold text-primary">${escapeHtml(r.name)} · ${escapeHtml(r.interest)}</p>
          <p class="text-sm text-on-surface-variant break-words">${escapeHtml(r.email)} · ${escapeHtml(r.phone)}${r.organization ? ` · ${escapeHtml(r.organization)}` : ''}</p>
          ${r.message ? `<p class="text-sm text-primary break-words">${escapeHtml(r.message)}</p>` : ''}
          <p class="text-xs text-outline">${escapeHtml(date(r.created_at))}</p>
        </div>`).join('')
    })
  </script>
</AdminLayout>
