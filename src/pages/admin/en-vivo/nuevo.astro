---
import AdminLayout from '../../../layouts/AdminLayout.astro'
---
<AdminLayout title="Nueva Transmisión" section="Transmisiones en Vivo / Nuevo">
  <div class="flex flex-col gap-6 max-w-3xl">
    <div class="flex items-center gap-4">
      <a href="/admin/en-vivo" class="p-2 rounded-xl hover:bg-surface-container-low transition-colors min-w-[44px] min-h-[44px] flex items-center justify-center">
        <span class="material-symbols-outlined">arrow_back</span>
      </a>
      <div>
        <h1 class="text-[28px] font-bold text-primary">Crear Transmisión en Vivo</h1>
        <p class="text-sm text-on-surface-variant mt-1">Conecta con tu instancia Owncast</p>
      </div>
    </div>

    <div class="bg-blue-50 border border-blue-200 rounded-2xl p-4 flex items-start gap-3">
      <span class="material-symbols-outlined text-blue-600">info</span>
      <div class="text-sm">
        <p class="font-semibold text-blue-900">Owncast configurado</p>
        <p class="text-blue-700 mt-0.5">Usa el stream key y URL HLS de tu instancia Owncast. Todo es 100% gratis.</p>
      </div>
    </div>

    <form id="live-form" class="flex flex-col gap-6">
      <div class="bg-white rounded-2xl border border-[#dce2f3] shadow-sm overflow-hidden">
        <div class="px-6 py-4 border-b border-[#dce2f3]">
          <h2 class="font-semibold text-primary">Información de la Transmisión</h2>
        </div>
        <div class="p-6 flex flex-col gap-4">
          <div class="flex flex-col gap-2">
            <label class="text-sm font-semibold text-primary">Título *</label>
            <input name="title" required type="text" placeholder="Ej. Congreso Internacional - Sesión Inaugural" class="w-full px-4 py-3 rounded-xl border border-[#dce2f3] focus:border-secondary focus:ring-4 focus:ring-secondary/10 outline-none transition-all text-base" />
          </div>
          <div class="flex flex-col gap-2">
            <label class="text-sm font-semibold text-primary">Ponente / Presentador *</label>
            <input name="speaker" required type="text" placeholder="Nombre del ponente" class="w-full px-4 py-3 rounded-xl border border-[#dce2f3] focus:border-secondary focus:ring-4 focus:ring-secondary/10 outline-none transition-all text-base" />
          </div>
          <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            <div class="flex flex-col gap-2">
              <label class="text-sm font-semibold text-primary">Fecha y hora programada *</label>
              <input name="scheduled_at" required type="datetime-local" class="w-full px-4 py-3 rounded-xl border border-[#dce2f3] focus:border-secondary focus:ring-4 focus:ring-secondary/10 outline-none transition-all text-base" />
            </div>
            <div class="flex flex-col gap-2">
              <label class="text-sm font-semibold text-primary">Estado</label>
              <select name="status" class="w-full px-4 py-3 rounded-xl border border-[#dce2f3] focus:border-secondary focus:ring-4 focus:ring-secondary/10 outline-none transition-all text-base">
                <option value="programado">Programado</option>
                <option value="en_vivo">En vivo</option>
                <option value="finalizado">Finalizado</option>
                <option value="cancelado">Cancelado</option>
              </select>
            </div>
          </div>
          <div class="flex flex-col gap-2">
            <label class="text-sm font-semibold text-primary">Descripción</label>
            <textarea name="description" rows="3" placeholder="Detalles de la transmisión..." class="w-full px-4 py-3 rounded-xl border border-[#dce2f3] focus:border-secondary focus:ring-4 focus:ring-secondary/10 outline-none transition-all text-base resize-none"></textarea>
          </div>
        </div>
      </div>

      <div class="bg-white rounded-2xl border border-[#dce2f3] shadow-sm overflow-hidden">
        <div class="px-6 py-4 border-b border-[#dce2f3]">
          <h2 class="font-semibold text-primary">Configuración Owncast</h2>
        </div>
        <div class="p-6 flex flex-col gap-4">
          <div class="flex flex-col gap-2">
            <label class="text-sm font-semibold text-primary">URL HLS (.m3u8) *</label>
            <input name="hls_url" required type="url" placeholder="https://tu-owncast.com/hls/stream.m3u8" class="w-full px-4 py-3 rounded-xl border border-[#dce2f3] focus:border-secondary focus:ring-4 focus:ring-secondary/10 outline-none transition-all text-base" />
            <p class="text-xs text-on-surface-variant">Esta es la URL que se reproducirá en la app</p>
          </div>
          <div class="flex flex-col gap-2">
            <label class="text-sm font-semibold text-primary">URL de la instancia Owncast</label>
            <input name="owncast_url" type="url" placeholder="https://tu-owncast.com" class="w-full px-4 py-3 rounded-xl border border-[#dce2f3] focus:border-secondary focus:ring-4 focus:ring-secondary/10 outline-none transition-all text-base" />
          </div>
        </div>
      </div>

      <div class="flex flex-col sm:flex-row gap-3">
        <button type="submit" class="flex-1 sm:flex-none inline-flex items-center justify-center gap-2 bg-secondary text-on-secondary px-8 py-3 rounded-xl font-semibold hover:bg-secondary-deep transition-colors min-h-[48px]">
          <span class="material-symbols-outlined text-[20px]">podcasts</span>
          Crear Transmisión
        </button>
        <a href="/admin/en-vivo" class="flex-1 sm:flex-none inline-flex items-center justify-center gap-2 bg-white text-primary px-8 py-3 rounded-xl font-semibold border border-[#dce2f3] hover:bg-surface-container-low transition-colors min-h-[48px]">
          Cancelar
        </a>
      </div>
    </form>
  </div>

  <script>
    import { adminFetch } from '../../../lib/admin-fetch'
    const form = document.getElementById('live-form') as HTMLFormElement
    form?.addEventListener('submit', async (e) => {
      e.preventDefault()
      const formData = new FormData(form)
      const body: any = {}
      formData.forEach((v, k) => { body[k] = v })
      if (body.scheduled_at) body.scheduled_at = new Date(body.scheduled_at).toISOString()
      const res = await adminFetch('/api/admin/lives', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(body)
      })
      const json = await res.json()
      if (res.ok) {
        alert('Transmisión creada correctamente')
        window.location.href = '/admin/en-vivo'
      } else {
        alert(json.error || 'Error al crear transmisión')
      }
    })
  </script>
</AdminLayout>
