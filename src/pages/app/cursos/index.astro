---
import AppLayout from '../../../layouts/AppLayout.astro'
import MyCourses from '../../../components/courses/MyCourses'
---
<AppLayout title="Mis Cursos" section="Mis Cursos" active="/app/cursos">
  <div class="flex flex-col gap-5 pt-5 pb-10">
    <section class="text-center">
      <h1 class="text-[28px] font-bold text-primary">Mis Cursos</h1>
