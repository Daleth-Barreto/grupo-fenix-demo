---
import AppLayout from '../../../layouts/AppLayout.astro'
import { MOCK_COURSES } from '../../../data/mock'

const TABS = [
  { key: 'Todos', icon: 'apps' },
  { key: 'En Curso', icon: 'play_circle' },
  { key: 'Finalizado', icon: 'check_circle' },
]
---
<AppLayout title="Mis Cursos" section="Mis Cursos" active="/app/cursos">
  <div class="flex flex-col gap-5 pt-5 pb-10">
    <section class="text-center">
      <h1 class="text-[28px] font-bold text-primary">Mis Cursos</h1>
      <p class="text-sm text-on-surface-variant mt-1.5">Tu formación continua</p>
    </section>

    <!-- Tabs -->
    <div class="flex gap-2" id="course-tabs">
      {TABS.map((tab, i) => (
        <button
          data-tab={tab.key}
          aria-pressed={i === 0 ? 'true' : 'false'}
          class:list={[
            'flex-1 py-3 rounded-2xl text-sm font-semibold transition-all active:scale-95 course-tab flex items-center justify-center gap-1.5',
            i === 0
              ? 'tab-active'
              : 'tab-inactive',
          ]}
        >
          <span class="material-symbols-outlined text-[18px]" style={i === 0 ? "font-variation-settings: 'FILL' 1" : undefined}>{tab.icon}</span>
          {tab.key}
        </button>
      ))}
    </div>

    <!-- Course List -->
    <div class="flex flex-col gap-4" id="courses-list">
      {MOCK_COURSES.map((course) => {
        const lessonIds = course.modules.flatMap((m) => m.lessons.map((l) => l.id))
        return (
          <a href={`/app/cursos/${course.id}`} data-status="En Curso" data-course-id={course.id} data-lessons={lessonIds.join(',')}
            class="bg-surface rounded-3xl shadow-card border border-surface-variant/70 overflow-hidden hover:shadow-elevated transition-all active:scale-[0.98] duration-150 block course-card animate-fade-in-up">
            
            <!-- Thumbnail -->
            <div class="relative w-full h-36 overflow-hidden bg-primary">
              {course.thumbnail_url ? (
                <img src={course.thumbnail_url} alt={course.title} class="w-full h-full object-cover" />
              ) : (
                <div class="w-full h-full bg-navy-gradient flex items-center justify-center">
                  <span class="material-symbols-outlined text-white/30 text-[48px]">school</span>
                </div>
              )}
              <!-- Status badge: lo actualiza el script con el progreso real -->
              <div class="course-badge absolute top-3 right-3 px-3 py-1 rounded-full text-[11px] font-semibold backdrop-blur-md bg-primary/90 text-white">En Curso</div>
            </div>

            <!-- Content -->
            <div class="p-4 flex flex-col gap-2">
              <h3 class="text-[15px] font-semibold text-primary line-clamp-2 leading-snug">{course.title}</h3>
              <p class="text-xs text-on-surface-variant flex items-center gap-1.5">
                <span class="material-symbols-outlined text-[14px]">person</span>
                {course.instructor}
              </p>
              <div class="flex items-center gap-3">
                <div class="flex-1 h-1.5 bg-surface-variant rounded-full overflow-hidden">
                  <div class="course-bar h-full bg-secondary rounded-full transition-all duration-700" style="width:0%"></div>
                </div>
                <span class="course-percent text-xs text-on-surface-variant w-8 text-right font-medium">0%</span>
              </div>
            </div>
          </a>
        )
      })}
    </div>

    <!-- Empty state -->
    <div id="empty-state" class="hidden flex-col items-center justify-center gap-3 py-16">
      <span class="material-symbols-outlined text-[48px] text-outline">school</span>
      <p class="text-sm text-on-surface-variant font-medium">No hay cursos en esta categoría</p>
    </div>
  </div>
</AppLayout>

<style>
  .tab-active {
    background-color: var(--color-secondary);
    color: #ffffff;
    box-shadow: 0 4px 14px -3px rgba(254, 149, 17, 0.45);
  }
  .tab-inactive {
    background-color: var(--color-surface);
    border: 1px solid var(--color-surface-variant);
    color: var(--color-on-surface-variant);
  }
  .tab-inactive:hover {
    background-color: var(--color-surface-container-low);
  }
</style>

<script>
  import { onAppReady } from '../../../utils/app-ready'
  import { adminFetch } from '../../../lib/admin-fetch'

  onAppReady(() => {
    adminFetch('/api/progress')
      .then(async (res) => {
        if (!res.ok) return
        const { lesson_ids } = (await res.json()) as { lesson_ids: string[] }
        const done = new Set(lesson_ids)
        document.querySelectorAll<HTMLElement>('.course-card').forEach((card) => {
          const lessons = (card.dataset.lessons ?? '').split(',').filter(Boolean)
          const percent = lessons.length ? Math.round((lessons.filter((id) => done.has(id)).length / lessons.length) * 100) : 0
          const status = percent >= 100 ? 'Finalizado' : 'En Curso'
          card.dataset.status = status
          const bar = card.querySelector<HTMLElement>('.course-bar')
          const label = card.querySelector('.course-percent')
          const badge = card.querySelector('.course-badge')
          if (bar) bar.style.width = `${percent}%`
          if (label) label.textContent = `${percent}%`
          if (badge) badge.textContent = status
        })
      })
      .catch(() => {})

    const tabs = document.querySelectorAll<HTMLButtonElement>('.course-tab')
    const cards = document.querySelectorAll<HTMLElement>('.course-card')
    const emptyState = document.getElementById('empty-state')

    tabs.forEach((tab) => {
      tab.addEventListener('click', () => {
        // Reset all tabs
        tabs.forEach((t) => {
          t.classList.remove('tab-active')
          t.classList.add('tab-inactive')
          t.setAttribute('aria-pressed', 'false')
          const icon = t.querySelector('.material-symbols-outlined') as HTMLElement | null
          if (icon) icon.style.fontVariationSettings = ''
        })
        // Activate clicked tab
        tab.classList.add('tab-active')
        tab.classList.remove('tab-inactive')
        tab.setAttribute('aria-pressed', 'true')
        const activeIcon = tab.querySelector('.material-symbols-outlined') as HTMLElement | null
        if (activeIcon) activeIcon.style.fontVariationSettings = "'FILL' 1"

        const selected = tab.dataset.tab
        let visibleCount = 0

        cards.forEach((card) => {
          const show = selected === 'Todos' || card.dataset.status === selected
          card.style.display = show ? '' : 'none'
          if (show) visibleCount++
        })

        // Show/hide empty state
        if (emptyState) {
          emptyState.style.display = visibleCount === 0 ? 'flex' : 'none'
        }
      })
    })
  })
</script>
