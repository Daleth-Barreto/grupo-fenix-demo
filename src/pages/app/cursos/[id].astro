---
import BaseLayout from '../../../layouts/BaseLayout.astro'
import AuthGuard from '../../../components/auth/AuthGuard'
import CourseDetail from '../../../components/courses/CourseDetail'

export const prerender = false

const { id } = Astro.params
if (!id) return Astro.redirect('/app/cursos')
---
<BaseLayout title="Curso">
  <AuthGuard client:load>
    <div class="min-h-screen bg-background pb-28">
      <header class="sticky top-0 z-50 bg-surface/95 backdrop-blur-md border-b border-surface-variant shadow-card" style="padding-top: env(safe-area-inset-top, 0px);">
        <div class="px-5 max-w-2xl mx-auto flex items-center gap-3 h-16">
          <a href="/app/cursos" aria-label="Volver a mis cursos" class="p-2.5 -ml-2 rounded-full text-primary hover:bg-surface-container transition-colors active:scale-95 min-w-[44px] min-h-[44px] flex items-center justify-center">
            <span class="material-symbols-outlined">arrow_back</span>
          </a>
          <span class="font-semibold text-primary text-[15px] truncate">Contenido del curso</span>
        </div>
      </header>
      <main class="px-5 max-w-2xl mx-auto pt-6">
        <CourseDetail client:only="react" courseId={id} />
      </main>
    </div>
  </AuthGuard>
</BaseLayout>
