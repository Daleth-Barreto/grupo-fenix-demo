---
import AppLayout from '../../../layouts/AppLayout.astro'

const inputClass = 'w-full bg-surface-soft rounded-2xl py-4 px-4 text-base text-primary placeholder:text-outline border border-transparent focus:border-secondary focus:ring-4 focus:ring-secondary/10 outline-none transition-all min-h-[52px] disabled:opacity-60'
const labelClass = 'text-[13px] font-semibold text-primary ml-1'
---
<AppLayout title="Datos personales" section="Datos personales" showBack>
  <div class="py-6 flex flex-col gap-6 max-w-xl mx-auto pb-12">
    <form id="datos-form" class="flex flex-col gap-5">
      <div class="flex flex-col gap-2">
        <label for="full-name" class={labelClass}>Nombre completo</label>
        <input id="full-name" name="full_name" type="text" autocomplete="name" maxlength="100" placeholder="Tu nombre y apellidos" class={inputClass} />
      </div>

      <div class="flex flex-col gap-2">
        <label for="email" class={labelClass}>Correo electrónico</label>
        <input id="email" name="email" type="email" disabled class={inputClass} />
        <p class="text-xs text-outline ml-1">Por ahora el correo no se puede cambiar desde la app.</p>
      </div>

      <p id="datos-status" role="status" aria-live="polite" class="text-sm min-h-[1.25rem]"></p>

      <button type="submit"
        class="w-full inline-flex items-center justify-center gap-2 font-semibold rounded-2xl bg-secondary text-on-secondary hover:bg-secondary-deep shadow-card text-[15px] py-4 px-6 disabled:opacity-60 transition-all active:scale-[0.98] min-h-[52px]">
        Guardar cambios
      </button>
    </form>
  </div>
</AppLayout>

<script>
  import { supabase } from '../../../lib/supabase'
  import { onAppReady } from '../../../utils/app-ready'
  import { adminFetch } from '../../../lib/admin-fetch'

  onAppReady(async () => {
    const form = document.getElementById('datos-form') as HTMLFormElement | null
    const nameInput = document.getElementById('full-name') as HTMLInputElement | null
    const emailInput = document.getElementById('email') as HTMLInputElement | null
    const status = document.getElementById('datos-status')
    const submit = form?.querySelector('button[type="submit"]') as HTMLButtonElement | null
    if (!form || !nameInput || !emailInput) return

    const say = (msg: string, ok = false) => {
      if (!status) return
      status.textContent = msg
      status.className = `text-sm min-h-[1.25rem] ${ok ? 'text-success' : 'text-error'}`
    }

    const { data } = await supabase.auth.getSession()
    const user = data.session?.user
    if (user) {
      nameInput.value = (user.user_metadata?.full_name as string | undefined) ?? ''
      emailInput.value = user.email ?? ''
    }

    form.addEventListener('submit', async (e) => {
      e.preventDefault()
      const fullName = nameInput.value.trim()
      if (fullName.length < 3) {
        say('Escribe tu nombre completo (mínimo 3 caracteres).')
        return
      }
      if (submit) submit.disabled = true
      say('Guardando…', true)
      const { error } = await supabase.auth.updateUser({ data: { full_name: fullName } })
      const profile = error ? null : await adminFetch('/api/account/profile', {
        method: 'PUT',
        body: JSON.stringify({ full_name: fullName }),
      }).catch(() => null)
      if (submit) submit.disabled = false
      if (error || !profile?.ok) {
        say('No se pudo guardar. Intenta de nuevo.')
        return
      }
      say('Datos actualizados.', true)
    })
  })
</script>
