---
import AppLayout from '../../layouts/AppLayout.astro'
---
<AppLayout title="Configuración" section="Configuración" showBack>
  <div class="py-6 flex flex-col gap-5 max-w-xl mx-auto pb-12">
    <!-- Cuenta -->
    <section class="flex flex-col gap-2">
      <h2 class="text-[11px] font-bold text-primary uppercase tracking-widest ml-1">Cuenta</h2>
      <div class="bg-surface rounded-3xl shadow-card border border-surface-variant/70 overflow-hidden">
        <a href="/app/configuracion/datos" class="flex items-center justify-between px-4 py-4 border-b border-surface-variant/70 hover:bg-surface-container-low transition-colors">
          <div class="flex items-center gap-4">
            <span class="material-symbols-outlined text-primary text-[22px]">person</span>
            <p class="text-sm font-medium text-primary">Información personal</p>
          </div>
          <span class="material-symbols-outlined text-outline-variant">chevron_right</span>
        </a>
        <a href="/app/configuracion/contrasena" class="flex items-center justify-between px-4 py-4 border-b border-surface-variant/70 hover:bg-surface-container-low transition-colors">
          <div class="flex items-center gap-4">
            <span class="material-symbols-outlined text-primary text-[22px]">lock</span>
            <p class="text-sm font-medium text-primary">Cambiar contraseña</p>
          </div>
          <span class="material-symbols-outlined text-outline-variant">chevron_right</span>
        </a>
        <a href="/app/configuracion/pagos" class="flex items-center justify-between px-4 py-4 hover:bg-surface-container-low transition-colors">
          <div class="flex items-center gap-4">
            <span class="material-symbols-outlined text-primary text-[22px]">credit_card</span>
            <p class="text-sm font-medium text-primary">Métodos de pago</p>
          </div>
          <span class="material-symbols-outlined text-outline-variant">chevron_right</span>
        </a>
      </div>
    </section>

    <!-- Preferencias -->
    <section class="flex flex-col gap-2">
      <h2 class="text-[11px] font-bold text-primary uppercase tracking-widest ml-1">Preferencias</h2>
      <div class="bg-surface rounded-3xl shadow-card border border-surface-variant/70 overflow-hidden">
        <div class="px-4 py-4 border-b border-surface-variant/70 flex flex-col gap-3">
          <div class="flex items-center gap-4">
            <span class="material-symbols-outlined text-primary text-[22px]">dark_mode</span>
            <p id="pref-theme-label" class="text-sm font-medium text-primary">Apariencia</p>
          </div>
          <div id="theme-options" role="group" aria-labelledby="pref-theme-label" class="grid grid-cols-3 gap-1 bg-surface-container-low rounded-2xl p-1">
            <button type="button" data-theme-option="light" aria-pressed="false" class="theme-option rounded-xl py-2.5 text-sm font-semibold text-on-surface-variant min-h-[44px]">Claro</button>
            <button type="button" data-theme-option="dark" aria-pressed="false" class="theme-option rounded-xl py-2.5 text-sm font-semibold text-on-surface-variant min-h-[44px]">Oscuro</button>
            <button type="button" data-theme-option="auto" aria-pressed="false" class="theme-option rounded-xl py-2.5 text-sm font-semibold text-on-surface-variant min-h-[44px]">Automático</button>
          </div>
          <p class="text-xs text-on-surface-variant">Automático sigue el modo de tu celular. Se guarda en este dispositivo.</p>
        </div>
        <div class="flex items-center justify-between px-4 py-4 border-b border-surface-variant/70">
          <div class="flex items-center gap-4">
            <span class="material-symbols-outlined text-primary text-[22px]">notifications</span>
            <p id="pref-notif-label" class="text-sm font-medium text-primary">Notificaciones de eventos</p>
          </div>
          <button type="button" role="switch" aria-labelledby="pref-notif-label" aria-checked="true"
            class="toggle-btn relative w-12 h-6 rounded-full transition-colors duration-300 bg-secondary" data-active="true" data-pref="notif_eventos">
            <span class="toggle-knob absolute top-0.5 left-0.5 w-5 h-5 bg-white rounded-full shadow transition-transform duration-300 translate-x-6"></span>
          </button>
        </div>
        <div class="flex items-center justify-between px-4 py-4">
          <div class="flex items-center gap-4">
            <span class="material-symbols-outlined text-primary text-[22px]">mail</span>
            <p id="pref-promo-label" class="text-sm font-medium text-primary">Correos promocionales</p>
          </div>
          <button type="button" role="switch" aria-labelledby="pref-promo-label" aria-checked="false"
            class="toggle-btn relative w-12 h-6 rounded-full transition-colors duration-300 bg-surface-variant" data-active="false" data-pref="correos_promo">
            <span class="toggle-knob absolute top-0.5 left-0.5 w-5 h-5 bg-white rounded-full shadow transition-transform duration-300 translate-x-0"></span>
          </button>
        </div>
      </div>
      <p id="prefs-status" role="status" aria-live="polite" class="text-xs text-on-surface-variant ml-1 min-h-[1rem]"></p>
    </section>

    <!-- Acerca de -->
    <section class="flex flex-col gap-2">
      <h2 class="text-[11px] font-bold text-primary uppercase tracking-widest ml-1">Acerca de</h2>
      <div class="bg-surface rounded-3xl shadow-card border border-surface-variant/70 overflow-hidden">
        <a href="/app/configuracion/terminos" class="flex items-center justify-between px-4 py-4 border-b border-surface-variant/70 hover:bg-surface-container-low transition-colors">
          <div class="flex items-center gap-4">
            <span class="material-symbols-outlined text-primary text-[22px]">description</span>
            <p class="text-sm font-medium text-primary">Términos y condiciones</p>
          </div>
          <span class="material-symbols-outlined text-outline-variant">chevron_right</span>
        </a>
        <a href="/app/configuracion/privacidad" class="flex items-center justify-between px-4 py-4 hover:bg-surface-container-low transition-colors">
          <div class="flex items-center gap-4">
            <span class="material-symbols-outlined text-primary text-[22px]">policy</span>
            <p class="text-sm font-medium text-primary">Aviso de privacidad</p>
          </div>
          <span class="material-symbols-outlined text-outline-variant">chevron_right</span>
        </a>
      </div>
    </section>

    <!-- Zona de Peligro: /api/account/delete rechaza la baja si hay compras o constancias -->
    <section class="flex flex-col gap-2">
      <h2 class="text-[11px] font-bold text-error uppercase tracking-widest ml-1">Zona de Peligro</h2>
      <div class="bg-surface rounded-3xl shadow-card border border-surface-variant/70 overflow-hidden">
        <button type="button" id="btn-delete-account" class="w-full flex items-center justify-between px-4 py-4 hover:bg-surface-container-low transition-colors text-left">
          <span class="flex items-center gap-4">
            <span class="material-symbols-outlined text-error text-[22px]">delete</span>
            <span class="text-sm font-bold text-error">Eliminar mi cuenta</span>
          </span>
          <span class="material-symbols-outlined text-outline-variant">chevron_right</span>
        </button>
      </div>
    </section>

    <p class="text-center text-xs text-outline mt-4">Grupo FÉNIX App v1.0.0</p>
  </div>
  <div id="delete-dialog" role="dialog" aria-modal="true" aria-labelledby="delete-title" class="fixed inset-0 z-50 flex items-end justify-center bg-navy/50 backdrop-blur-sm hidden">
    <div class="bg-surface rounded-t-3xl w-full max-w-md p-6 flex flex-col gap-4" style="padding-bottom: calc(1.5rem + env(safe-area-inset-bottom, 0px));">
      <h3 id="delete-title" class="text-[18px] font-bold text-primary">¿Eliminar tu cuenta?</h3>
      <p class="text-sm text-on-surface-variant leading-relaxed">
        Esta acción es permanente y no se puede deshacer. Si tienes compras, inscripciones o constancias, deberás solicitarlo a soporte.
      </p>
      <p id="delete-error" role="alert" class="text-sm text-error hidden"></p>
      <button type="button" id="btn-confirm-delete" class="bg-error-solid text-white font-semibold text-[15px] py-4 rounded-2xl w-full disabled:opacity-60">Sí, eliminar mi cuenta</button>
      <button type="button" id="btn-cancel-delete" class="bg-transparent text-primary border border-primary hover:bg-surface-container-low font-semibold text-[15px] py-4 rounded-2xl w-full">Cancelar</button>
    </div>
  </div>
</AppLayout>

<script>
  import { supabase } from '../../lib/supabase'
  import { onAppReady } from '../../utils/app-ready'
  import { adminFetch } from '../../lib/admin-fetch'

  const setToggle = (btn: HTMLButtonElement, on: boolean) => {
    btn.setAttribute('aria-checked', String(on))
    btn.setAttribute('data-active', String(on))
    btn.classList.toggle('bg-secondary', on)
    btn.classList.toggle('bg-surface-variant', !on)
    btn.querySelector('.toggle-knob')?.classList.toggle('translate-x-6', on)
    btn.querySelector('.toggle-knob')?.classList.toggle('translate-x-0', !on)
  }

  onAppReady(async () => {
    const theme = (window as unknown as { fenixTheme: { read: () => string; set: (choice: string) => void } }).fenixTheme
    const themeButtons = document.querySelectorAll<HTMLButtonElement>('.theme-option')
    const showTheme = (choice: string) => {
      themeButtons.forEach((btn) => {
        const on = btn.dataset.themeOption === choice
        btn.setAttribute('aria-pressed', String(on))
        btn.classList.toggle('bg-secondary', on)
        btn.classList.toggle('text-on-secondary', on)
        btn.classList.toggle('text-on-surface-variant', !on)
      })
    }
    showTheme(theme.read())
    themeButtons.forEach((btn) => {
      btn.addEventListener('click', () => {
        const choice = btn.dataset.themeOption ?? 'light'
        theme.set(choice)
        showTheme(choice)
      })
    })

    const toggles = document.querySelectorAll<HTMLButtonElement>('.toggle-btn')
    const status = document.getElementById('prefs-status')
    const say = (msg: string) => { if (status) status.textContent = msg }

    // Las preferencias se guardan en user_metadata de Supabase, así que viajan con la cuenta
    const { data } = await supabase.auth.getSession()
    const meta: Record<string, unknown> = data.session?.user.user_metadata ?? {}
    toggles.forEach((btn) => {
      const key = btn.dataset.pref
      if (key && typeof meta[key] === 'boolean') setToggle(btn, meta[key] as boolean)
    })

    toggles.forEach((btn) => {
      btn.addEventListener('click', async () => {
        const key = btn.dataset.pref
        if (!key) return
        const next = btn.getAttribute('aria-checked') !== 'true'
        setToggle(btn, next)
        btn.disabled = true
        say('Guardando…')
        const { error } = await supabase.auth.updateUser({ data: { [key]: next } })
        btn.disabled = false
        if (error) {
          setToggle(btn, !next)
          say('No se pudo guardar. Intenta de nuevo.')
        } else {
          say('Preferencia guardada.')
        }
      })
    })

    const dialog = document.getElementById('delete-dialog')
    const openBtn = document.getElementById('btn-delete-account')
    const cancelBtn = document.getElementById('btn-cancel-delete')
    const confirmBtn = document.getElementById('btn-confirm-delete') as HTMLButtonElement | null
    const deleteError = document.getElementById('delete-error')
    const closeDialog = () => {
      dialog?.classList.add('hidden')
      openBtn?.focus()
    }

    openBtn?.addEventListener('click', () => {
      deleteError?.classList.add('hidden')
      dialog?.classList.remove('hidden')
      cancelBtn?.focus()
    })
    cancelBtn?.addEventListener('click', closeDialog)
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !dialog?.classList.contains('hidden')) closeDialog()
    })
    confirmBtn?.addEventListener('click', async () => {
      confirmBtn.disabled = true
      deleteError?.classList.add('hidden')
      try {
        const res = await adminFetch('/api/account/delete', { method: 'POST' })
        if (!res.ok) {
          const body = (await res.json().catch(() => ({}))) as { error?: string }
          throw new Error(body.error || 'No se pudo eliminar la cuenta.')
        }
        await supabase.auth.signOut()
        window.location.href = '/app/login'
      } catch (err) {
        if (deleteError) {
          deleteError.textContent = err instanceof Error ? err.message : 'No se pudo eliminar la cuenta.'
          deleteError.classList.remove('hidden')
        }
        confirmBtn.disabled = false
      }
    })
  })
</script>
