---
import AppLayout from '../../../layouts/AppLayout.astro'
---
<AppLayout title="Error de pago" section="Pago" requireAuth={false}>
  <div class="pt-10 pb-10 flex flex-col items-center text-center px-5">
    <div class="w-24 h-24 rounded-full bg-red-100 flex items-center justify-center mb-6">
      <span class="material-symbols-outlined text-red-600 text-[48px] filled">error</span>
    </div>
    <h1 class="text-[28px] font-bold text-primary mb-2">Pago no completado</h1>
    <p class="text-sm text-on-surface-variant mb-8 max-w-xs leading-relaxed">
      No completaste el pago, así que no se realizó ningún cargo. Puedes intentarlo de nuevo cuando quieras.
    </p>
    <div class="flex flex-col gap-3 w-full max-w-sm">
      <a id="retry-payment" href="/app/congresos" class="w-full bg-secondary hover:bg-secondary-deep text-on-secondary font-semibold text-[15px] py-4 rounded-2xl shadow-card transition-all active:scale-[0.98]">
        Intentar nuevamente
      </a>
      <a href="/app/congresos" class="w-full bg-surface-soft text-primary font-semibold text-[15px] py-4 rounded-2xl border border-surface-variant transition-all active:scale-[0.98]">
        Volver a congresos
      </a>
    </div>
  </div>
</AppLayout>

<script>
  const eventId = new URLSearchParams(window.location.search).get('event')
  const retry = document.getElementById('retry-payment') as HTMLAnchorElement | null
  if (retry && eventId) retry.href = `/app/checkout/${encodeURIComponent(eventId)}`
</script>
