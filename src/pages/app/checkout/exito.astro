---
import AppLayout from '../../../layouts/AppLayout.astro'
---
<AppLayout title="Pago exitoso" section="Pago" requireAuth={false}>
  <div class="pt-10 pb-10 flex flex-col items-center text-center px-5">
    <div class="w-24 h-24 rounded-full bg-green-100 flex items-center justify-center mb-6">
      <span class="material-symbols-outlined text-green-600 text-[48px] filled">check_circle</span>
    </div>
    <h1 class="text-[28px] font-bold text-primary mb-2">¡Pago exitoso!</h1>
    <p class="text-sm text-on-surface-variant mb-8 max-w-xs leading-relaxed">
      Tu inscripción se ha procesado correctamente. Ya tienes acceso al contenido adquirido.
    </p>
    <div class="flex flex-col gap-3 w-full max-w-sm">
      <a href="/app/inicio" class="w-full bg-secondary hover:bg-secondary-deep text-on-secondary font-semibold text-[15px] py-4 rounded-2xl shadow-card transition-all active:scale-[0.98]">
        Ir al inicio
      </a>
      <a href="/app/comprobantes" class="w-full bg-surface-soft text-primary font-semibold text-[15px] py-4 rounded-2xl border border-surface-variant transition-all active:scale-[0.98]">
        Ver comprobantes
      </a>
    </div>
  </div>
</AppLayout>
