---
import AppLayout from '../../layouts/AppLayout.astro'
import LogoutButtonProfile from '../../components/profile/LogoutButtonProfile'

const MENU_ITEMS = [
  { icon: 'workspace_premium', label: 'Mis constancias', sub: 'Descarga tus certificados', path: '/app/constancias' },
  { icon: 'event_available', label: 'Reservaciones y cotización', sub: 'Solicita un evento a tu medida', path: '/app/reservaciones' },
  { icon: 'receipt_long', label: 'Mis comprobantes', sub: 'Historial de pagos y facturas', path: '/app/comprobantes' },
  { icon: 'person', label: 'Datos personales', sub: 'Actualiza tu información', path: '/app/configuracion/datos' },
]
---
<AppLayout title="Perfil" section="Perfil" showSettings showLogout={true} active="/app/perfil">
  <div class="pt-6 pb-10 flex flex-col gap-7 max-w-xl mx-auto">
    <!-- Avatar -->
    <section class="flex flex-col items-center text-center animate-fade-in-up">
      <div class="relative mb-3.5">
        <div class="w-24 h-24 rounded-3xl overflow-hidden border-4 border-surface shadow-card flex items-center justify-center bg-navy-gradient">
          <span class="text-white text-[32px] font-bold" id="profile-initial">M</span>
        </div>
        <button type="button" disabled aria-label="Cambiar foto (próximamente)" title="Próximamente"
          class="absolute -bottom-1 -right-1 bg-secondary text-on-secondary rounded-full p-1.5 shadow-card border-2 border-surface opacity-50 cursor-not-allowed">
          <span class="material-symbols-outlined text-[14px] filled">edit</span>
        </button>
      </div>
      <h1 class="text-[20px] font-bold text-primary" id="profile-name">Usuario</h1>
      <p class="text-sm text-outline mt-0.5" id="profile-email">Cargando...</p>
    </section>

    <!-- Eventos inscritos -->
    <a href="/app/congresos" class="relative overflow-hidden rounded-3xl shadow-card bg-navy-gradient hover:shadow-elevated transition-shadow active:scale-[0.98] duration-150 block group">
      <div class="absolute top-0 left-0 right-0 h-1 accent-line"></div>
      <div class="relative z-10 flex items-center justify-between p-6">
        <div>
          <p class="text-white/80 text-sm font-medium mb-2">Mis eventos inscritos</p>
          <div class="flex items-center gap-2.5">
            <span class="material-symbols-outlined text-secondary text-[28px] filled">local_activity</span>
          </div>
        </div>
        <div class="bg-white/10 rounded-full p-2.5 group-hover:bg-white/20 transition-colors">
          <span class="material-symbols-outlined text-white">chevron_right</span>
        </div>
      </div>
    </a>

    <!-- Menú -->
    <nav class="flex flex-col gap-1.5">
      {MENU_ITEMS.map((item) => (
        <a href={item.path} class="flex items-center justify-between py-4 px-4 bg-surface rounded-3xl shadow-card border border-surface-variant/70 hover:shadow-elevated hover:border-surface-variant transition-all duration-200 text-left active:scale-[0.98] w-full group">
          <div class="flex items-center gap-4">
            <div class="bg-surface-container-low group-hover:bg-primary p-2.5 rounded-full text-primary group-hover:text-white transition-colors">
              <span class="material-symbols-outlined text-[20px] filled">{item.icon}</span>
            </div>
            <div>
              <p class="text-sm font-semibold text-primary">{item.label}</p>
              <p class="text-xs text-outline mt-0.5">{item.sub}</p>
            </div>
          </div>
          <span class="material-symbols-outlined text-outline-variant group-hover:text-secondary transition-colors">chevron_right</span>
        </a>
      ))}
    </nav>

    <!-- Logout -->
    <LogoutButtonProfile client:load />
  </div>
</AppLayout>

<script>
  import { supabase } from '../../lib/supabase'
  import { onAppReady } from '../../utils/app-ready'

  // Muestra nombre, correo e inicial de la sesión una vez que la página está lista
  onAppReady(() => {
    supabase.auth.getSession().then(({ data }) => {
      if (!data.session?.user) return
      const { email, user_metadata } = data.session.user
      const nameEl = document.getElementById('profile-name')
      const emailEl = document.getElementById('profile-email')
      const initialEl = document.getElementById('profile-initial')
      const fullName = user_metadata?.full_name || email?.split('@')[0] || 'Usuario'
      if (nameEl) nameEl.textContent = fullName
      if (emailEl && email) emailEl.textContent = email
      if (initialEl) initialEl.textContent = fullName.charAt(0).toUpperCase()
    })
  })
</script>
