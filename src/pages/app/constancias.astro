---
import AppLayout from '../../layouts/AppLayout.astro'
import { MOCK_CONSTANCIAS } from '../../data/mock'
---
<AppLayout title="Constancias" section="Constancias" showBack active="/app/constancias">
  <div class="pt-5 pb-10">
    <section class="mb-7 text-center">
      <h1 class="text-[28px] font-bold text-primary">Constancias</h1>
      <p class="text-sm text-on-surface-variant mt-1.5">Aquí encontrarás los certificados de tus eventos</p>
    </section>

    <div class="grid grid-cols-1 gap-5">
      {MOCK_CONSTANCIAS.map((c) => (
        <article class="bg-surface shadow-sm border border-surface-variant/70 p-5 flex flex-col gap-4 hover:shadow-md transition-shadow duration-300 relative overflow-hidden rounded-3xl">
          <div class="absolute -top-10 -right-10 w-36 h-36 bg-primary-fixed rounded-full blur-3xl opacity-60 pointer-events-none"></div>

          <div class="w-full h-32 rounded-2xl bg-primary flex items-center justify-center relative z-10 overflow-hidden shadow-inner">
            {c.preview_url ? (
              <img src={c.preview_url} alt={c.title} class="w-full h-full object-cover" />
            ) : (
              <div class="flex flex-col items-center gap-2">
                <span class="material-symbols-outlined text-white text-[44px]" style="font-variation-settings: 'FILL' 1">workspace_premium</span>
                <span class="text-on-primary-container text-xs font-medium">Grupo FÉNIX</span>
              </div>
            )}
          </div>

          <div class="relative z-10">
            <h3 class="text-[15px] font-semibold text-primary leading-snug">{c.title}</h3>
            <p class="text-xs text-on-surface-variant mt-1">{c.issued_at}</p>
          </div>

          <div class="flex gap-3 relative z-10 mt-1">
            <button class="flex-1 border border-primary text-primary text-sm font-semibold py-3 rounded-2xl hover:bg-surface-container-low transition-colors active:scale-[0.98]">
              Descargar PDF
            </button>
            <button class="flex-1 bg-secondary text-on-secondary text-sm font-semibold py-3 rounded-2xl hover:bg-secondary-deep transition-colors shadow-card active:scale-[0.98]">
              Ver
            </button>
          </div>
        </article>
      ))}

      {MOCK_CONSTANCIAS.length === 0 && (
        <div class="text-center py-16">
          <span class="material-symbols-outlined text-[56px] text-outline-variant block mb-3">workspace_premium</span>
          <p class="text-sm text-on-surface-variant">Aún no tienes constancias disponibles.</p>
          <p class="text-xs text-outline mt-1">Completa un evento o curso para obtener tu certificado.</p>
        </div>
      )}
    </div>
  </div>
</AppLayout>
