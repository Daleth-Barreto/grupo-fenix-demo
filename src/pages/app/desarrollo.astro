---
import AppLayout from '../../layouts/AppLayout.astro'
import { CERTIFICACIONES } from '../../data/sitio'
---
<AppLayout title="Desarrollo profesional" section="Desarrollo profesional" showBack active="/app/congresos" requireAuth={false}>
  <div class="flex flex-col gap-8 pt-5 pb-10">
    <section>
      <h1 class="text-[28px] font-bold text-primary leading-tight">Certificaciones especializadas</h1>
      <p class="text-sm text-on-surface-variant mt-2 leading-relaxed">Impulsa tu desarrollo profesional con formación especializada en psicología y salud.</p>
    </section>

    {CERTIFICACIONES.map((item) => (
      <section id={item.id} class="flex flex-col gap-4">
        <img src={item.imagen} alt="" loading="lazy" class="w-full aspect-[3/2] object-cover rounded-3xl shadow-card" />
        <div>
          <h2 class="text-[20px] font-bold text-primary leading-snug">{item.titulo}</h2>
          <p class="text-sm text-on-surface-variant mt-1 leading-relaxed">{item.subtitulo}</p>
        </div>
        <ul class="flex flex-col gap-1.5 text-sm font-medium text-primary">
          {item.detalles.map((text) => <li>{text}</li>)}
        </ul>
        <p class="text-sm text-on-surface-variant leading-relaxed">{item.objetivo}</p>
        <div class="flex flex-col gap-1.5">
          <h3 class="text-[15px] font-bold text-primary">Es para ti si</h3>
          <ul class="flex flex-col gap-1.5 text-sm text-on-surface-variant">{item.paraQuien.map((text) => <li>{text}</li>)}</ul>
        </div>
        <div class="flex flex-col gap-1.5">
          <h3 class="text-[15px] font-bold text-primary">Qué incluye</h3>
          <ul class="flex flex-col gap-1.5 text-sm text-on-surface-variant">{item.incluye.map((text) => <li>{text}</li>)}</ul>
        </div>
        <div class="flex flex-col gap-2">
          <h3 class="text-[15px] font-bold text-primary">Talleres</h3>
          {item.talleres.map((taller, index) => (
            <div class="bg-surface rounded-2xl border border-surface-variant/70 p-4">
              <p class="text-sm font-semibold text-primary">Taller {index + 1}: {taller.titulo}</p>
              <p class="text-xs text-on-surface-variant mt-1">{taller.lema}</p>
              <p class="text-xs font-semibold text-secondary-deep mt-2">{taller.horas} horas</p>
            </div>
          ))}
        </div>
        <div class="flex flex-col gap-2">
          <h3 class="text-[15px] font-bold text-primary">Lo que dicen nuestros alumnos</h3>
          {item.testimonios.map((testimonio) => (
            <blockquote class="bg-surface-container-low rounded-2xl p-4">
              <p class="text-xs text-on-surface-variant leading-relaxed">"{testimonio.texto}"</p>
              <footer class="text-xs font-semibold text-primary mt-2">{testimonio.nombre}</footer>
            </blockquote>
          ))}
        </div>
        <a href="/app/reservaciones" class="self-start inline-flex bg-secondary text-on-secondary px-6 py-3 rounded-2xl font-semibold text-sm min-h-[48px] items-center">Reservar</a>
      </section>
    ))}
  </div>
</AppLayout>
