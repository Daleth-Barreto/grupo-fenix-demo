---
import AppLayout from '../../layouts/AppLayout.astro'
import { TRAYECTORIA } from '../../data/sitio'
---
<AppLayout title="Trayectoria Fénix" section="Trayectoria Fénix" showBack active="/app/congresos" requireAuth={false}>
  <div class="flex flex-col gap-6 pt-5 pb-10">
    <section class="text-center">
      <h1 class="text-[28px] font-bold text-primary">Trayectoria Fénix</h1>
      <p class="text-sm text-on-surface-variant mt-1.5">Los congresos que hemos llevado a escena</p>
    </section>

    <div class="grid grid-cols-2 gap-4" id="gallery-grid">
      {TRAYECTORIA.map((item) => (
        <a href={`/app/galeria/${item.slug}`} class="gallery-item block group">
          <div class="relative rounded-2xl overflow-hidden shadow-card aspect-[4/3] bg-navy">
            <img src={item.imagen} alt="" loading="lazy" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" />
            <div class="absolute inset-0 bg-gradient-to-t from-navy/90 via-navy/40 to-transparent"></div>
            <div class="absolute bottom-0 left-0 right-0 p-3">
              <p class="text-xs font-semibold text-white line-clamp-3 leading-snug">{item.titulo}</p>
              <p class="text-white/80 text-[11px] mt-1">{item.anio ?? item.lugar}{item.asistentes ? ` · ${item.asistentes} asistentes` : ''}</p>
            </div>
          </div>
        </a>
      ))}
    </div>

    <a href="/app/congresos" class="self-center inline-flex bg-secondary text-on-secondary px-6 py-3 rounded-2xl font-semibold text-sm min-h-[48px] items-center">Ver próximos congresos</a>
  </div>
</AppLayout>
