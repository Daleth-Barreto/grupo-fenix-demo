---
import AppLayout from '../../layouts/AppLayout.astro'

const INTERESTS = ['Congreso', 'Capacitación a medida', 'Curso o taller', 'Evento corporativo']
---
<AppLayout title="Reservaciones" section="Reservaciones y cotización" showBack active="/app/congresos">
  <div class="pt-5 pb-10 flex flex-col gap-6">
    <section class="text-center">
      <h1 class="text-[28px] font-bold text-primary leading-tight">Eventos a<br />tu medida</h1>
      <p class="text-sm text-on-surface-variant mt-2 max-w-sm mx-auto">
        Déjanos tus datos y un asesor académico se comunicará contigo.
      </p>
    </section>

    <!-- Stepper Progress -->
    <div class="px-8 mt-2 mb-4">
      <div class="flex items-center justify-between relative isolate">
        <div class="absolute left-0 right-0 top-1/2 -translate-y-1/2 h-0.5 bg-surface-variant -z-10"></div>
        <div id="progress-bar" class="absolute left-0 top-1/2 -translate-y-1/2 h-0.5 bg-secondary -z-10 transition-all duration-500 w-0"></div>

        <div class="step-indicator w-8 h-8 rounded-full bg-secondary text-white flex items-center justify-center font-bold shadow-sm transition-colors duration-300" data-step="1">1</div>
        <div class="step-indicator w-8 h-8 rounded-full bg-surface border border-surface-variant text-on-surface-variant flex items-center justify-center font-bold shadow-sm transition-colors duration-300" data-step="2">2</div>
        <div class="step-indicator w-8 h-8 rounded-full bg-surface border border-surface-variant text-on-surface-variant flex items-center justify-center font-bold shadow-sm transition-colors duration-300" data-step="3">3</div>
      </div>
    </div>

    <!-- Formulario Multi-paso (Vanilla JS) -->
    <form id="reservation-form" class="bg-surface rounded-3xl p-6 shadow-card border border-surface-variant/70">

      <!-- Paso 1: Interés -->
      <div class="step-content flex flex-col" data-step="1">
        <h2 class="text-[17px] font-bold text-primary mb-4">¿Qué tipo de evento buscas?</h2>
        <div class="flex flex-col gap-2.5">
          {INTERESTS.map((int) => (
            <label class="flex items-center justify-between p-4 rounded-2xl border border-surface-variant/70 cursor-pointer hover:bg-surface-container-low transition-colors interest-label">
              <span class="text-sm font-semibold text-primary">{int}</span>
              <input type="radio" name="interest" value={int} class="w-5 h-5 accent-secondary" required />
            </label>
          ))}
        </div>
        <div class="mt-auto pt-6">
          <button type="button" class="btn-next w-full bg-secondary text-on-secondary font-semibold text-[15px] py-4 rounded-2xl shadow-card active:scale-[0.98] transition-transform">Continuar</button>
        </div>
      </div>

      <!-- Paso 2: Datos Contacto -->
      <div class="step-content flex-col hidden" data-step="2">
        <h2 class="text-[17px] font-bold text-primary mb-4">Datos de contacto</h2>
        <div class="flex flex-col gap-4">
          <div class="flex flex-col gap-1.5">
            <label for="res-name" class="text-[13px] font-semibold text-primary ml-1">Nombre completo</label>
            <input id="res-name" type="text" name="name" autocomplete="name" minlength="3" required class="w-full bg-surface-soft rounded-2xl py-3.5 px-4 text-sm text-primary placeholder:text-outline border border-transparent focus:border-secondary focus:ring-4 focus:ring-secondary/10 outline-none transition-all" placeholder="Ej. Dra. María López" />
          </div>
          <div class="flex flex-col gap-1.5">
            <label for="res-email" class="text-[13px] font-semibold text-primary ml-1">Correo electrónico</label>
            <input id="res-email" type="email" name="email" autocomplete="email" required class="w-full bg-surface-soft rounded-2xl py-3.5 px-4 text-sm text-primary placeholder:text-outline border border-transparent focus:border-secondary focus:ring-4 focus:ring-secondary/10 outline-none transition-all" placeholder="correo@hospital.com" />
          </div>
          <div class="flex flex-col gap-1.5">
            <label for="res-phone" class="text-[13px] font-semibold text-primary ml-1">Teléfono o WhatsApp</label>
            <input id="res-phone" type="tel" name="phone" autocomplete="tel" minlength="10" required class="w-full bg-surface-soft rounded-2xl py-3.5 px-4 text-sm text-primary placeholder:text-outline border border-transparent focus:border-secondary focus:ring-4 focus:ring-secondary/10 outline-none transition-all" placeholder="10 dígitos" />
          </div>
        </div>
        <div class="mt-auto pt-6 flex gap-3">
          <button type="button" class="btn-prev w-1/3 bg-transparent text-primary border border-primary hover:bg-surface-container-low font-semibold text-[15px] py-4 rounded-2xl active:scale-[0.98] transition-transform">Atrás</button>
          <button type="button" class="btn-next w-2/3 bg-secondary text-on-secondary font-semibold text-[15px] py-4 rounded-2xl shadow-card active:scale-[0.98] transition-transform">Continuar</button>
        </div>
      </div>

      <!-- Paso 3: Detalles -->
      <div class="step-content flex-col hidden" data-step="3">
        <h2 class="text-[17px] font-bold text-primary mb-4">Detalles adicionales</h2>
        <div class="flex flex-col gap-4">
          <div class="flex flex-col gap-1.5">
            <label for="res-org" class="text-[13px] font-semibold text-primary ml-1">Institución / Hospital (Opcional)</label>
            <input id="res-org" type="text" name="organization" class="w-full bg-surface-soft rounded-2xl py-3.5 px-4 text-sm text-primary placeholder:text-outline border border-transparent focus:border-secondary focus:ring-4 focus:ring-secondary/10 outline-none transition-all" placeholder="Hospital General..." />
          </div>
          <div class="flex flex-col gap-1.5">
            <label for="res-message" class="text-[13px] font-semibold text-primary ml-1">Mensaje o requerimientos</label>
            <textarea id="res-message" name="message" rows="3" class="w-full bg-surface-soft rounded-2xl py-3.5 px-4 text-sm text-primary placeholder:text-outline border border-transparent focus:border-secondary focus:ring-4 focus:ring-secondary/10 outline-none transition-all resize-none" placeholder="Me interesa un curso sobre..."></textarea>
          </div>
        </div>
        <p id="reservation-error" role="alert" class="text-sm text-error mt-4 hidden"></p>
        <div class="mt-auto pt-6 flex gap-3">
          <button type="button" class="btn-prev w-1/3 bg-transparent text-primary border border-primary hover:bg-surface-container-low font-semibold text-[15px] py-4 rounded-2xl active:scale-[0.98] transition-transform">Atrás</button>
          <button type="submit" id="reservation-submit" class="w-2/3 bg-navy text-on-primary font-semibold text-[15px] py-4 rounded-2xl shadow-card active:scale-[0.98] transition-transform flex items-center justify-center gap-2 disabled:opacity-60">
            Solicitar <span class="material-symbols-outlined text-[18px]">send</span>
          </button>
        </div>
      </div>

      <!-- Pantalla de Éxito -->
      <div id="success-screen" role="status" class="flex-col items-center justify-center text-center py-6 hidden">
        <div class="w-20 h-20 rounded-3xl bg-surface-container flex items-center justify-center mb-5">
          <span class="material-symbols-outlined text-secondary text-[44px] filled">mark_email_read</span>
        </div>
        <h2 class="text-[22px] font-bold text-primary leading-tight">Solicitud enviada</h2>
        <p class="text-sm text-on-surface-variant mt-2">
          Gracias por tu interés. Un asesor académico se pondrá en contacto contigo muy pronto.
        </p>
        <a href="/app/inicio" class="mt-8 bg-secondary text-on-secondary font-semibold text-[15px] py-4 px-6 rounded-2xl shadow-card w-full">Volver al inicio</a>
      </div>
    </form>
  </div>
</AppLayout>

<script>
  import { onAppReady } from '../../utils/app-ready'
  import { adminFetch } from '../../lib/admin-fetch'

  onAppReady(() => {
  let currentStep = 1
  const totalSteps = 3
  const form = document.getElementById('reservation-form') as HTMLFormElement
  const contents = document.querySelectorAll('.step-content') as NodeListOf<HTMLElement>
  const indicators = document.querySelectorAll('.step-indicator') as NodeListOf<HTMLElement>
  const bar = document.getElementById('progress-bar') as HTMLElement

  const updateUI = () => {
    contents.forEach((el, idx) => {
      const active = idx + 1 === currentStep
      el.classList.toggle('hidden', !active)
      el.classList.toggle('flex', active)
    })

    indicators.forEach((ind, idx) => {
      const step = idx + 1
      if (step <= currentStep) {
        ind.classList.remove('bg-surface', 'border', 'border-surface-variant', 'text-on-surface-variant')
        ind.classList.add('bg-secondary', 'text-white')
      } else {
        ind.classList.add('bg-surface', 'border', 'border-surface-variant', 'text-on-surface-variant')
        ind.classList.remove('bg-secondary', 'text-white')
      }
    })

    bar.style.width = `${((currentStep - 1) / (totalSteps - 1)) * 100}%`
  }

  document.querySelectorAll('.btn-next').forEach(btn => {
    btn.addEventListener('click', () => {
      // Basic validation for the current step
      const currentInputs = contents[currentStep - 1].querySelectorAll('input, select, textarea') as NodeListOf<HTMLInputElement>
      let valid = true
      currentInputs.forEach(input => {
        if (!input.checkValidity()) {
          input.reportValidity()
          valid = false
        }
      })
      if (valid && currentStep < totalSteps) {
        currentStep++
        updateUI()
      }
    })
  })

  document.querySelectorAll('.btn-prev').forEach(btn => {
    btn.addEventListener('click', () => {
      if (currentStep > 1) {
        currentStep--
        updateUI()
      }
    })
  })

  form.addEventListener('submit', async (e) => {
    e.preventDefault()
    const errorEl = document.getElementById('reservation-error')
    const submit = document.getElementById('reservation-submit') as HTMLButtonElement | null
    errorEl?.classList.add('hidden')
    if (submit) submit.disabled = true
    try {
      const res = await adminFetch('/api/reservations', {
        method: 'POST',
        body: JSON.stringify(Object.fromEntries(new FormData(form))),
      })
      if (!res.ok) {
        const body = (await res.json().catch(() => ({}))) as { error?: string }
        throw new Error(body.error || 'No se pudo enviar tu solicitud.')
      }
      contents.forEach((el) => { el.classList.add('hidden'); el.classList.remove('flex') })
      const success = document.getElementById('success-screen')
      success?.classList.remove('hidden')
      success?.classList.add('flex')
    } catch (err) {
      if (errorEl) {
        errorEl.textContent = err instanceof Error ? err.message : 'No se pudo enviar tu solicitud.'
        errorEl.classList.remove('hidden')
      }
      if (submit) submit.disabled = false
    }
  })
  })
</script>
