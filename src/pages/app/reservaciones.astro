---
import AppLayout from '../../layouts/AppLayout.astro'

const INTERESTS = ['Congreso', 'Capacitación a medida', 'Curso o taller', 'Evento corporativo']
---
<AppLayout title="Reservaciones" section="Reservaciones y cotización" showBack active="/app/congresos">
  <div class="pt-5 pb-10 flex flex-col gap-6">
    <section class="text-center">
      <h1 class="text-[28px] font-bold text-primary leading-tight">Eventos a<br />tu medida</h1>
      <p class="text-sm text-on-surface-variant mt-2 max-w-sm mx-auto">
        Déjanos tus datos y un asesor académico se comunicará contigo.
      </p>
    </section>

    <!-- Stepper Progress -->
    <div class="px-8 mt-2 mb-4">
      <div class="flex items-center justify-between relative">
        <div class="absolute left-0 right-0 top-1/2 -translate-y-1/2 h-0.5 bg-surface-variant -z-10"></div>
        <div id="progress-bar" class="absolute left-0 top-1/2 -translate-y-1/2 h-0.5 bg-secondary -z-10 transition-all duration-500 w-0"></div>

        <div class="step-indicator w-8 h-8 rounded-full bg-secondary text-white flex items-center justify-center font-bold shadow-sm transition-colors duration-300" data-step="1">1</div>
        <div class="step-indicator w-8 h-8 rounded-full bg-surface border border-surface-variant text-on-surface-variant flex items-center justify-center font-bold shadow-sm transition-colors duration-300 delay-100" data-step="2">2</div>
        <div class="step-indicator w-8 h-8 rounded-full bg-surface border border-surface-variant text-on-surface-variant flex items-center justify-center font-bold shadow-sm transition-colors duration-300 delay-100" data-step="3">3</div>
      </div>
    </div>

    <!-- Formulario Multi-paso (Vanilla JS) -->
    <form id="reservation-form" class="bg-surface rounded-3xl p-6 shadow-card border border-surface-variant/70 overflow-hidden relative min-h-[360px]">

      <!-- Paso 1: Interés -->
      <div class="step-content absolute inset-0 p-6 flex flex-col transition-all duration-500 ease-in-out" data-step="1">
        <h2 class="text-[17px] font-bold text-primary mb-4">¿Qué tipo de evento buscas?</h2>
        <div class="flex flex-col gap-2.5">
          {INTERESTS.map((int) => (
            <label class="flex items-center justify-between p-4 rounded-2xl border border-surface-variant/70 cursor-pointer hover:bg-surface-container-low transition-colors interest-label">
              <span class="text-sm font-semibold text-primary">{int}</span>
              <input type="radio" name="interest" value={int} class="w-5 h-5 accent-secondary" required />
            </label>
          ))}
        </div>
        <div class="mt-auto pt-6">
          <button type="button" class="btn-next w-full bg-secondary text-on-secondary font-semibold text-[15px] py-4 rounded-2xl shadow-card active:scale-[0.98] transition-transform">Continuar</button>
        </div>
      </div>

      <!-- Paso 2: Datos Contacto -->
      <div class="step-content absolute inset-0 p-6 flex flex-col transition-all duration-500 ease-in-out translate-x-full opacity-0 pointer-events-none" data-step="2">
        <h2 class="text-[17px] font-bold text-primary mb-4">Datos de contacto</h2>
        <div class="flex flex-col gap-4">
          <div class="flex flex-col gap-1.5">
            <label class="text-[13px] font-semibold text-primary ml-1">Nombre completo</label>
            <input type="text" name="name" required class="w-full bg-surface-soft rounded-2xl py-3.5 px-4 text-sm text-primary placeholder:text-outline border border-transparent focus:border-secondary focus:ring-4 focus:ring-secondary/10 outline-none transition-all" placeholder="Ej. Dra. María López" />
          </div>
          <div class="flex flex-col gap-1.5">
            <label class="text-[13px] font-semibold text-primary ml-1">Correo electrónico</label>
            <input type="email" name="email" required class="w-full bg-surface-soft rounded-2xl py-3.5 px-4 text-sm text-primary placeholder:text-outline border border-transparent focus:border-secondary focus:ring-4 focus:ring-secondary/10 outline-none transition-all" placeholder="correo@hospital.com" />
          </div>
          <div class="flex flex-col gap-1.5">
            <label class="text-[13px] font-semibold text-primary ml-1">Teléfono o WhatsApp</label>
            <input type="tel" name="phone" required class="w-full bg-surface-soft rounded-2xl py-3.5 px-4 text-sm text-primary placeholder:text-outline border border-transparent focus:border-secondary focus:ring-4 focus:ring-secondary/10 outline-none transition-all" placeholder="10 dígitos" />
          </div>
        </div>
        <div class="mt-auto pt-6 flex gap-3">
          <button type="button" class="btn-prev w-1/3 bg-transparent text-primary border border-primary hover:bg-surface-container-low font-semibold text-[15px] py-4 rounded-2xl active:scale-[0.98] transition-transform">Atrás</button>
          <button type="button" class="btn-next w-2/3 bg-secondary text-on-secondary font-semibold text-[15px] py-4 rounded-2xl shadow-card active:scale-[0.98] transition-transform">Continuar</button>
        </div>
      </div>

      <!-- Paso 3: Detalles -->
      <div class="step-content absolute inset-0 p-6 flex flex-col transition-all duration-500 ease-in-out translate-x-full opacity-0 pointer-events-none" data-step="3">
        <h2 class="text-[17px] font-bold text-primary mb-4">Detalles adicionales</h2>
        <div class="flex flex-col gap-4">
          <div class="flex flex-col gap-1.5">
            <label class="text-[13px] font-semibold text-primary ml-1">Institución / Hospital (Opcional)</label>
            <input type="text" name="organization" class="w-full bg-surface-soft rounded-2xl py-3.5 px-4 text-sm text-primary placeholder:text-outline border border-transparent focus:border-secondary focus:ring-4 focus:ring-secondary/10 outline-none transition-all" placeholder="Hospital General..." />
          </div>
          <div class="flex flex-col gap-1.5">
            <label class="text-[13px] font-semibold text-primary ml-1">Mensaje o requerimientos</label>
            <textarea name="message" rows="3" class="w-full bg-surface-soft rounded-2xl py-3.5 px-4 text-sm text-primary placeholder:text-outline border border-transparent focus:border-secondary focus:ring-4 focus:ring-secondary/10 outline-none transition-all resize-none" placeholder="Me interesa un curso sobre..."></textarea>
          </div>
        </div>
        <div class="mt-auto pt-6 flex gap-3">
          <button type="button" class="btn-prev w-1/3 bg-transparent text-primary border border-primary hover:bg-surface-container-low font-semibold text-[15px] py-4 rounded-2xl active:scale-[0.98] transition-transform">Atrás</button>
          <button type="submit" class="w-2/3 bg-primary text-on-primary font-semibold text-[15px] py-4 rounded-2xl shadow-card active:scale-[0.98] transition-transform flex items-center justify-center gap-2">
            Solicitar <span class="material-symbols-outlined text-[18px]">send</span>
          </button>
        </div>
      </div>

      <!-- Pantalla de Éxito -->
      <div id="success-screen" class="absolute inset-0 bg-surface z-10 p-6 flex flex-col items-center justify-center text-center opacity-0 pointer-events-none transition-opacity duration-500">
        <div class="w-20 h-20 rounded-3xl bg-surface-container flex items-center justify-center mb-5">
          <span class="material-symbols-outlined text-secondary text-[44px] filled">mark_email_read</span>
        </div>
        <h2 class="text-[22px] font-bold text-primary leading-tight">Solicitud enviada</h2>
        <p class="text-sm text-on-surface-variant mt-2">
          Gracias por tu interés. Un asesor académico se pondrá en contacto contigo muy pronto.
        </p>
        <a href="/app/inicio" class="mt-8 bg-secondary text-on-secondary font-semibold text-[15px] py-4 px-6 rounded-2xl shadow-card w-full">Volver al inicio</a>
      </div>
    </form>
  </div>
</AppLayout>

<script>
  let currentStep = 1
  const totalSteps = 3
  const form = document.getElementById('reservation-form') as HTMLFormElement
  const contents = document.querySelectorAll('.step-content') as NodeListOf<HTMLElement>
  const indicators = document.querySelectorAll('.step-indicator') as NodeListOf<HTMLElement>
  const bar = document.getElementById('progress-bar') as HTMLElement

  const updateUI = () => {
    contents.forEach((el, idx) => {
      const step = idx + 1
      if (step === currentStep) {
        el.classList.remove('translate-x-full', '-translate-x-full', 'opacity-0', 'pointer-events-none')
      } else if (step < currentStep) {
        el.classList.add('-translate-x-full', 'opacity-0', 'pointer-events-none')
        el.classList.remove('translate-x-full')
      } else {
        el.classList.add('translate-x-full', 'opacity-0', 'pointer-events-none')
        el.classList.remove('-translate-x-full')
      }
    })

    indicators.forEach((ind, idx) => {
      const step = idx + 1
      if (step <= currentStep) {
        ind.classList.remove('bg-surface', 'border', 'border-surface-variant', 'text-on-surface-variant')
        ind.classList.add('bg-secondary', 'text-white')
      } else {
        ind.classList.add('bg-surface', 'border', 'border-surface-variant', 'text-on-surface-variant')
        ind.classList.remove('bg-secondary', 'text-white')
      }
    })

    bar.style.width = `${((currentStep - 1) / (totalSteps - 1)) * 100}%`
  }

  document.querySelectorAll('.btn-next').forEach(btn => {
    btn.addEventListener('click', () => {
      // Basic validation for the current step
      const currentInputs = contents[currentStep - 1].querySelectorAll('input, select, textarea') as NodeListOf<HTMLInputElement>
      let valid = true
      currentInputs.forEach(input => {
        if (!input.checkValidity()) {
          input.reportValidity()
          valid = false
        }
      })
      if (valid && currentStep < totalSteps) {
        currentStep++
        updateUI()
      }
    })
  })

  document.querySelectorAll('.btn-prev').forEach(btn => {
    btn.addEventListener('click', () => {
      if (currentStep > 1) {
        currentStep--
        updateUI()
      }
    })
  })

  form.addEventListener('submit', (e) => {
    e.preventDefault()
    // Submit logical mockup
    const success = document.getElementById('success-screen') as HTMLElement
    success.classList.remove('opacity-0', 'pointer-events-none')
  })
</script>
