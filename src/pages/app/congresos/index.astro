---
import AppLayout from '../../../layouts/AppLayout.astro'
import EventCard from '../../../components/events/EventCard.astro'
import FeaturedHero from '../../../components/events/FeaturedHero.astro'
import { listEvents, featuredEvent } from '../../../lib/catalog'

export const prerender = false

const { events, failed } = await listEvents()
const featured = featuredEvent(events)
const CATEGORIES = ['Todos', 'Congreso', 'Capacitación', 'Curso', 'Taller', 'Diplomado', 'Seminario']
---
<AppLayout title="Congresos" section="Congresos" active="/app/congresos" requireAuth={false}>
  <div class="flex flex-col gap-7 pt-2 pb-10">
    <!-- Título -->
    <div class="pt-1">
      <h1 class="text-[28px] font-bold text-primary leading-tight tracking-tight">
        Vive la experiencia<br /><span class="text-secondary">Grupo Fénix</span>
      </h1>
      <p class="text-sm text-on-surface-variant leading-relaxed mt-2">
        Congresos, capacitaciones y talleres con valor curricular impartidos por especialistas.
      </p>

      <a href="/app/galeria" class="mt-4 w-full flex items-center justify-between bg-surface rounded-2xl border border-surface-variant/70 shadow-card px-4 py-3 hover:shadow-elevated transition-all active:scale-[0.98] group">
        <span class="flex items-center gap-3">
          <span class="w-9 h-9 rounded-xl bg-surface-container-low flex items-center justify-center text-primary group-hover:text-secondary transition-colors">
            <span class="material-symbols-outlined text-[20px]">photo_library</span>
          </span>
          <span class="text-sm font-semibold text-primary">Ver eventos realizados</span>
        </span>
        <span class="material-symbols-outlined text-outline-variant group-hover:text-secondary transition-colors">chevron_right</span>
      </a>
    </div>

    {featured && <FeaturedHero event={featured} />}

    <!-- Chips de filtro -->
    <div class="flex gap-2 overflow-x-auto no-scrollbar -mx-1 px-1" id="filter-chips">
      {CATEGORIES.map((cat, i) => (
        <button
          data-category={cat}
          class:list={[
            'px-5 py-2.5 rounded-full whitespace-nowrap text-sm font-semibold transition-all duration-200 active:scale-95 filter-chip',
            i === 0 ? 'bg-secondary text-on-secondary shadow-card active-chip' : 'bg-surface border border-surface-variant text-on-surface-variant hover:border-secondary hover:text-secondary',
          ]}
        >
          {cat}
        </button>
      ))}
    </div>

    <!-- Buscador y filtros -->
    <div class="flex flex-col gap-2 -mt-3">
      <input id="event-search" type="search" aria-label="Buscar eventos" placeholder="Buscar por tema o ciudad" class="w-full bg-surface-soft rounded-2xl py-3 px-4 text-base text-primary placeholder:text-outline border border-transparent focus:border-secondary outline-none min-h-[48px]" />
      <div class="grid grid-cols-2 gap-2">
        <select id="event-modality" aria-label="Modalidad" class="w-full bg-surface border border-surface-variant rounded-2xl py-3 px-3 text-sm text-primary min-h-[48px]">
          <option value="">Toda modalidad</option>
          <option value="Presencial">Presencial</option>
          <option value="En línea">En línea</option>
          <option value="Híbrido">Híbrido</option>
        </select>
        <select id="event-when" aria-label="Fecha" class="w-full bg-surface border border-surface-variant rounded-2xl py-3 px-3 text-sm text-primary min-h-[48px]">
          <option value="">Toda fecha</option>
          <option value="proximos">Próximos</option>
          <option value="pasados">Finalizados</option>
        </select>
      </div>
    </div>

    <!-- Resultados -->
    <div class="flex items-center justify-between -mt-2">
      <p class="text-xs text-outline font-medium" id="results-count">{events.length} {events.length === 1 ? 'evento' : 'eventos'}</p>
    </div>

    <!-- Grid de tarjetas -->
    <div class="grid grid-cols-1 gap-5" id="events-grid">
      {events.map((event, i) => (
        <div data-category={event.category} data-modality={event.modality} data-end={event.date_end} data-search={`${event.title} ${event.description} ${event.location}`.toLowerCase()}>
          <EventCard event={event} index={i} />
        </div>
      ))}
      {events.length === 0 && (
        <p class="text-sm text-on-surface-variant text-center py-12">
          {failed ? 'No pudimos cargar los eventos. Intenta de nuevo en un momento.' : 'Pronto publicaremos nuevos eventos.'}
        </p>
      )}
    </div>
  </div>
</AppLayout>

<script>
  import { onAppReady } from '../../../utils/app-ready'
  import { isEventPast } from '../../../utils/format'

  onAppReady(() => {
    const chips = document.querySelectorAll<HTMLElement>('.filter-chip')
    const cards = document.querySelectorAll<HTMLElement>('#events-grid > div')
    const count = document.getElementById('results-count')
    const search = document.getElementById('event-search') as unknown as HTMLInputElement
    const modality = document.getElementById('event-modality') as unknown as HTMLSelectElement
    const when = document.getElementById('event-when') as unknown as HTMLSelectElement
    let category = 'Todos'

    const apply = () => {
      const term = search.value.trim().toLowerCase()
      let visible = 0
      cards.forEach((card) => {
        const past = isEventPast(card.dataset.end ?? '')
        const show = (category === 'Todos' || card.dataset.category === category)
          && (!modality.value || card.dataset.modality === modality.value)
          && (!term || (card.dataset.search ?? '').includes(term))
          && (when.value === '' || (when.value === 'proximos' ? !past : past))
        card.style.display = show ? '' : 'none'
        if (show) visible++
      })
      if (count) count.textContent = visible === 0 ? 'Sin resultados. Prueba con otro filtro.' : `${visible} evento${visible !== 1 ? 's' : ''}`
    }

    chips.forEach((chip) => {
      chip.addEventListener('click', () => {
        chips.forEach((c) => {
          c.classList.remove('bg-secondary', 'text-on-secondary', 'shadow-card', 'active-chip')
          c.classList.add('bg-surface', 'border', 'border-surface-variant', 'text-on-surface-variant')
        })
        chip.classList.add('bg-secondary', 'text-on-secondary', 'shadow-card', 'active-chip')
        chip.classList.remove('bg-surface', 'border', 'border-surface-variant', 'text-on-surface-variant')
        category = chip.dataset.category ?? 'Todos'
        apply()
      })
    })
    search.addEventListener('input', apply)
    modality.addEventListener('change', apply)
    when.addEventListener('change', apply)
    apply()
  })
</script>
