---
import BaseLayout from '../../../layouts/BaseLayout.astro'
import LiveRoom from '../../../components/live/LiveRoom'
import AuthGuard from '../../../components/auth/AuthGuard'

// Los id vienen de Supabase, así que la página no se puede generar al compilar.
export const prerender = false

const { id } = Astro.params
if (!id) return Astro.redirect('/app/inicio')
---
<BaseLayout title="Transmisión en vivo">
  <AuthGuard client:load>
    <div class="min-h-screen bg-background">
      <header class="sticky top-0 z-50 bg-surface/98 backdrop-blur-lg border-b border-surface-variant shadow-card" style="padding-top: env(safe-area-inset-top, 0px);">
        <div class="px-4 sm:px-5 max-w-4xl mx-auto flex items-center gap-3 h-16">
          <a href="/app/inicio" aria-label="Volver al inicio" class="p-2.5 -ml-2 rounded-full text-primary hover:bg-surface-container transition-colors active:scale-95 min-w-[44px] min-h-[44px] flex items-center justify-center">
            <span class="material-symbols-outlined">arrow_back</span>
          </a>
          <span class="font-semibold text-primary text-[15px] truncate">Transmisión en vivo</span>
        </div>
      </header>

      <main class="max-w-4xl mx-auto">
        <LiveRoom client:only="react" liveId={id} />
      </main>
    </div>
  </AuthGuard>
</BaseLayout>
